<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Status__c</field>
        <field>Grand_Prize__c</field>
        <field>Draw_Type__c</field>
        <field>Selected_Draw__c</field>
        <field>Total_Prize_Fund__c</field>
        <field>Draw_Date__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Bahrain_Risk_Department</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Finance Department Validation - Is Approved/Rejected</label>
        <name>Risk_Department_Validation_Is_Approved_Rejected</name>
    </approvalStep>
    <description>For Bahrain - Approval process for Raffle/Draw: ICU Validation 2/Finance Department Validation</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND ( 2 OR 3 )</booleanFilter>
        <criteriaItems>
            <field>Draw__c.Status__c</field>
            <operation>equals</operation>
            <value>Pending Risk Dept Validation</value>
        </criteriaItems>
        <criteriaItems>
            <field>Draw__c.RegionFlag__c</field>
            <operation>equals</operation>
            <value>Bahrain</value>
        </criteriaItems>
        <criteriaItems>
            <field>Draw__c.RegionFlag__c</field>
            <operation>equals</operation>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Draw_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Draw_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Draw_Assigne_to_Draw_Risk_Dept</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Draw - Finance Department Validation</label>
    <processOrder>4</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
