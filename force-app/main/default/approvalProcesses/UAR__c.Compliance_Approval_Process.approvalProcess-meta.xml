<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>UAR_Compliance</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Compliance Review</label>
        <name>Compliance_Review</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>UAR__c.Checker_Result__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Close_the_UAR</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Close_the_UAR_Sub_Status</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Compliance_Result_to_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Close_the_UAR_1</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Compliance_Result_to_Declined</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_Compliance_Result_to_In_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Compliance Approval Process</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Assign_Back_to_Checker</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Escalation</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_First_Reminder</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Second_Reminder</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
