<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Approval_Status__c</field>
        <field>Case_Model__c</field>
        <field>Case_Status__c</field>
        <field>CreatedBy</field>
        <field>Description__c</field>
        <field>LastModifiedBy</field>
        <field>New_Limit__c</field>
        <field>Request_Type__c</field>
        <field>Role__c</field>
        <field>Subject__c</field>
        <field>Sub_Type__c</field>
        <field>Type__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_Status</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approver_User_Id</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Owner</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Owner</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Wavier_Approval_Limit__c.Approval_Status__c</field>
                <operation>equals</operation>
                <value>Pending</value>
            </criteriaItems>
            <criteriaItems>
                <field>Wavier_Approval_Limit__c.Case_Status__c</field>
                <operation>equals</operation>
                <value>Open</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Maker Approval Step</label>
        <name>Maker_Approval_Step</name>
        <rejectionActions>
            <action>
                <name>Approval_Status_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Case_Closed</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approval_Status_Updated</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Case_Closed</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approver_User_Id</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Owner</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Wavier_Approval_Limit__c.Approval_Status__c</field>
                <operation>equals</operation>
                <value>Approved by Maker</value>
            </criteriaItems>
            <criteriaItems>
                <field>Wavier_Approval_Limit__c.Case_Status__c</field>
                <operation>equals</operation>
                <value>Open</value>
            </criteriaItems>
        </entryCriteria>
        <label>Checker Approval Step</label>
        <name>Checker_Approval_Step</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Approval_Status_Reject_by_Checker</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Case_Closed</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Wavier_Approval_Limit__c.Case_Status__c</field>
            <operation>equals</operation>
            <value>Open</value>
        </criteriaItems>
        <criteriaItems>
            <field>Wavier_Approval_Limit__c.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Pending</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Approval Limits Process</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
