<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Employer_Name__c</field>
        <field>Temp_Employer_Name__c</field>
        <field>Employer_Name_in_Arabic__c</field>
        <field>Temp_Employer_Name_in_Arabic__c</field>
        <field>Grade_Rank__c</field>
        <field>Temp_Grade_Rank__c</field>
        <field>Category_Sector__c</field>
        <field>Temp_Category_Sector__c</field>
        <field>Sector_Code__c</field>
        <field>Temp_Sector_Code__c</field>
        <field>Sub_Sector__c</field>
        <field>Temp_Sub_Sector__c</field>
        <field>Type_of_Company__c</field>
        <field>Temp_Type_of_Company__c</field>
        <field>CR_Number__c</field>
        <field>Temp_CR_Number__c</field>
        <field>Registration_Date__c</field>
        <field>Temp_Registration_Date__c</field>
        <field>Owner_Equity_Capital__c</field>
        <field>Temp_Owner_s_Equity_Capital__c</field>
        <field>On_Boarding_Date_with_ila__c</field>
        <field>Temp_On_Boarding_Date_with_ila__c</field>
        <field>Number_of_Staff__c</field>
        <field>Temp_Number_of_Staff__c</field>
        <field>Salary_Range__c</field>
        <field>Temp_Salary_Range__c</field>
        <field>Bahrainis_and_Expat_Employees__c</field>
        <field>Temp_Bahrainis_and_Expat_Employees__c</field>
        <field>Shareholders_Owners_Details__c</field>
        <field>Temp_Shareholders_Owners_Details__c</field>
        <field>Suspended_Flag__c</field>
        <field>Temp_Suspended_Flag__c</field>
        <field>Email__c</field>
        <field>Temp_Email__c</field>
        <field>Company_Profile__c</field>
        <field>Temp_Company_Profile__c</field>
        <field>Company_URL__c</field>
        <field>Temp_Company_URL__c</field>
        <field>Remarks__c</field>
        <field>Temp_Remarks__c</field>
        <field>CR_Activities__c</field>
        <field>Temp_CR_Activities__c</field>
        <field>CR_Start_Date__c</field>
        <field>Temp_CR_Start_Date__c</field>
        <field>Address_PO_Box__c</field>
        <field>Temp_Address_P_O_Box__c</field>
        <field>Country__c</field>
        <field>Temp_Country__c</field>
        <field>Owner</field>
        <field>Name</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Listed_Employer_Update_Email_Alert</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Modification_Field_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Status_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Listed_Employer_Approval_Queue</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1 OR 2</booleanFilter>
            <criteriaItems>
                <field>Listed_Employers__c.Status__c</field>
                <operation>equals</operation>
                <value>Pending</value>
            </criteriaItems>
            <criteriaItems>
                <field>Listed_Employers__c.Modification_Status__c</field>
                <operation>equals</operation>
                <value>Pending</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Step 1</label>
        <name>Step_1</name>
        <rejectionActions>
            <action>
                <name>Modification_Field_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Status_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>This AP would trigger when record gets updated</description>
    <emailTemplate>unfiled$public/Approval_Process_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Listed_Employers__c.Modification_Status__c</field>
            <operation>equals</operation>
            <value>Pending</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Listed_Employer_Record_Email_Alert</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Listed Employee Update Approval Process</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
