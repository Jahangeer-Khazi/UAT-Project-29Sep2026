               <div class="columns col2">
                  <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="background-color: transparent; min-width: 100%; " class="slot-styling">
                     <tr>
                        <td style="padding: 0px 8px; " class="slot-styling camarker-inner">
                           <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="min-width: 100%; " class="stylingblock-content-wrapper">
                              <tr>
                                 <td class="stylingblock-content-wrapper camarker-inner">
                                    <h2 style="font-family: Helvetica; font-weight: bold;color:#696969;font-size:24px;">
                                       We’re glad you decided to take part in the ila Fantasy League 21-22, we wish you the best of luck!
                                    </h2>
                                    <p style="font-family: Helvetica;color:#696969;font-size:14px;">
                                       In order to participate in the raffle draws each month and be eligible for our “Manager of the Month” and grand prizes, please provide us with the following information.
                                    </p>
                                    <form method="post" >
                                       <label for="fantasyuser" style="font-family: Helvetica;color:#696969;font-weight: bold;font-size:15px;">Fantasy user name<br/>
                                       <div class="slds-form-element__control">
                                       <apex:inputField styleClass="slds-input" id="fantasyuser"  html-placeholder="Fantasy user name" value="{!objFan.Fantasy_Username__c}" required="true" styleclass="slds-select"  style="width:35%;" /></div></label><br/>
                                       <label for="name" style="font-family: Helvetica;color:#696969;font-weight: bold;font-size:15px;">Name<br/>
                                       <apex:inputField styleClass="slds-input" id="name123"  html-placeholder="Name"  value="{!objFan.Full_Name__c}" html-maxlength="150" required="true" onchange="allLetter();" styleclass="slds-select"  style="width:35%;"  /></label><br/>
                                       <font color='red'>
                                            <div id="une"> </div>
                                        </font>
                                        <font color='green'>
                                            <div id="une1"> </div>
                                        </font>
                                      <!-- CH01: Added by Prashant for validate Name should contain onlyb text only.-->
                                         <script type="text/javascript">
                                            function allLetter()  
                                             {    
                                               console.log('Method call@@@'); 
                                               var val = document.getElementById('{!$Component.name123}').value;
                                               console.log('Inside val'+val);           
                                                var letters = /^[A-Za-z ]+$/;  
                                                var inputtxt = document.getElementById('{!$Component.name123}').value;
                                                console.log('Method call@@@ Prashant'+inputtxt);  
                                                if(!inputtxt.match(letters))  
                                                {  
                                                  document.getElementById('une').innerHTML = "Name must be text only.";
                                                  document.getElementById('{!$Component.firstbutton}').disabled = true;
                                                }else{
                                                  document.getElementById('une').innerHTML = " ";
                                                  document.getElementById('{!$Component.firstbutton}').disabled = false;
                                                }                
                                              }  
                                         </script>
                                       <!-- CH01: End.-->  
                                       <label for="email" style="font-family: Helvetica;color:#696969;font-weight: bold;font-size:15px;">Email address<br/>
                                       <apex:inputField styleClass="slds-input" html-placeholder="E-mail address" type="email"  value="{!objFan.Email__c}" required="true" styleclass="slds-select"  style="width:35%;" /></label><br/>
                                       <label for="phone" style="font-family: Helvetica;color:#696969;font-weight: bold;font-size:15px;">Phone number<br/>
                                       <apex:inputField styleClass="slds-input" id="mob123" html-placeholder="Mobile number" type="tel" value="{!objFan.Mobile_Number__c}" html-maxlength="12" html-minlength="8" required="true" onchange="allLetters();" styleclass="slds-select"  style="width:35%;"  /></label><br/>
                                       <font color='red'>
                                            <div id="unes"> </div>
                                        </font>
                                        <font color='red'>
                                            <div id="unes1"> </div>
                                        </font>
                                      <!-- CH01: Added by Prashant for validate Name should contain onlyb text only.-->
                                         <script type="text/javascript">
                                            function allLetters()  
                                             {    
                                               console.log('Method call@@@'); 
                                               var val = document.getElementById('{!$Component.mob123}').value;
                                               console.log('Inside val'+val);           
                                                var letters = /^[0-9]+$/;  
                                                var inputtxt = document.getElementById('{!$Component.mob123}').value;
                                                console.log('Method call@@@ Prashant'+inputtxt);  
                                                if(!inputtxt.match(letters))  
                                                {  
                                                  document.getElementById('unes').innerHTML = "Mobile Number should not have text or special letters.";
                                                  document.getElementById('{!$Component.firstbutton}').disabled = true;
                                                }
                                                else{
                                                  document.getElementById('unes').innerHTML = " ";
                                                  document.getElementById('{!$Component.firstbutton}').disabled = false;
                                                }                
                                              }  
                                         </script>
                                       <apex:commandButton value="Sign up!"  id="firstbutton" action="{!saveRequest}" style="font-size:large;background:#7aee00;" styleClass="button Header-module--downloadButton--3T1JT"/>
                                    
                                    <br></br>
                                    </form>
                                    <p>
                                    <ul class="list" style="font-family: Helvetica;color:#696969;font-size:11px;">
                                       <em>Terms and conditions:</em>
                                       <li>You must be following our Instagram account to be eligible to win.</li>
                                       <li>To be eligible for the prize, you must have an ila Bank account</li>
                                       <li>You must use your personal email registered with ila Bank</li>
                                       <li>To be eligible to win a “Manager of the Month” prize, you must have joined before end of the month and is on top of the leaderboard for that given month</li>
                                       <li>Announcement for the prize winners will be at the end of each month, and the winner will be decided depending on each month's leaderboard.</li>
                                       <li>Staff members of Bank ABC or ila Bank do not qualify to take part.</li>
                                       <li>ila Bank can disqualify participants as they see fit.</li>
                                    </ul>
                                    </p>
                                 </td>
                              </tr>
