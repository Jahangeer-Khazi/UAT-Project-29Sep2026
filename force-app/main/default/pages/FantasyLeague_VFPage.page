                                 <a href="https://www.facebook.com/Ila-Bank-Bahrain-352144688790283/"><img data-assetid="15344" height="45" src="/resource/1647954167000/ilaFacebook" style="padding: 5px; text-align: center; height: 45px; width: 45px; border: 0px;" width="45"/></a>
                                 <a href="https://twitter.com/ilaBankBHR"><img data-assetid="15346" height="45" src="/resource/1647954217000/ilaTwitter" style="padding: 5px; text-align: center; height: 45px; width: 45px; border: 0px;" width="45"/></a>
                                 <a href="https://www.youtube.com/channel/UC_ycAB7SYwy1B5G7MRgJrFw"><img data-assetid="15347" height="45" src="/resource/1647954266000/ilaYoutube" style="padding: 5px; text-align: center; height: 45px; width: 45px; border: 0px;" width="45"/></a>
                                 <a href="https://www.linkedin.com/company/ilabank/"><img data-assetid="15343" height="45" src="/resource/1647954320000/ilaLinkedin" style="padding: 5px; text-align: center; height: 45px; width: 45px; border: 0px;" width="45"/></a><br/>
