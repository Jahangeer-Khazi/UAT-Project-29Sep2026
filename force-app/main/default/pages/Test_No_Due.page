            @page {
                margin-top: 1cm;
                margin-bottom: 2cm;
                margin-left: 0.5cm;
                margin-right: 0.5cm;
                
                @top-center {
                    content: element(headerTitle);
                }
                div.headerTitle {
                    position: running(headerTitle);
                }
            
                @bottom-left {
                    content: element(footer);
                }
            }
            
            table, td, th {
              border: 0px solid;
            }
            table {
                border-collapse: collapse;
            }
            .topmargin20 {
                margin-top:15px;
            }
            div.footer {
                    position: running(footer);
                    width:100%;
                }
            
            .repeatTableHeader{-fs-table-paginate: paginate;}
        </style>
    </head>
