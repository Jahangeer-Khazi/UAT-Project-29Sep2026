<apex:page controller="CBJCifReportPDFController" renderAs="pdf" applyHtmlTag="false" showHeader="false" sidebar="false" standardStylesheets="false">
<html>
<head>
    <style type="text/css" media="print">
        @page {
            size: A4;
            margin: 1cm;
            @bottom-right {
                content: "Page " counter(page) " of " counter(pages);
                font-family: 'Helvetica', 'Arial', sans-serif;
                font-size: 10px;
            }
        }
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            font-size: 12px;
            color: #333;
            line-height: 1.4;
        }
        .header {
            border-bottom: 2px solid #005fb2;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .header-title {
            font-size: 24px;
            color: #005fb2;
            font-weight: bold;
        }
        .header-date {
            float: right;
            font-size: 10px;
            color: #666;
            margin-top: 10px;
        }
        .section-title {
            background-color: #f3f2f2;
            padding: 8px 12px;
            font-size: 14px;
            font-weight: bold;
            color: #3e3e3c;
            border-left: 4px solid #005fb2;
            margin: 20px 0 10px 0;
        }
        .info-grid {
            width: 100%;
            margin-bottom: 10px;
        }
        .info-label {
            font-weight: bold;
            color: #706e6b;
            width: 30%;
            padding: 4px 0;
        }
        .info-value {
            color: #080707;
            padding: 4px 0;
        }
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
        }
        .data-table th {
            background-color: #005fb2;
            color: white;
            padding: 8px;
            text-align: left;
            font-size: 11px;
            border: 1px solid #004d91;
        }
        .data-table td {
            padding: 8px;
            border: 1px solid #d8dde6;
            font-size: 10px;
        }
        .data-table tr {
            page-break-inside: avoid;
        }
        .status-badge {
            font-weight: bold;
            text-transform: uppercase;
            font-size: 9px;
            display: inline-block;
        }
        .status-active { color: #2e7d32; }
        .status-pending { color: #8a6d3b; }
        .status-failed { color: #d32f2f; }
        .empty-msg {
            padding: 10px;
            text-align: center;
            color: #706e6b;
            font-style: italic;
        }
        .clearfix:after {
            content: "";
            display: block;
            clear: both;
        }
    </style>
</head>
<body>
    <div class="header clearfix">
        <span class="header-title">CRIF Report Summary</span>
        <span class="header-date">Generated on: {!todayDate}</span>
    </div>

    <div class="section-title">Customer Information</div>
    <table class="info-grid">
        <tr>
            <td class="info-label">Customer Name:</td>
            <td class="info-value">{!customer.name}</td>
            <td class="info-label">Customer CIF:</td>
            <td class="info-value">{!customer.cif}</td>
        </tr>
        <tr>
            <td class="info-label">Customer SAP ID:</td>
            <td class="info-value">{!customer.customerId}</td>
            <td class="info-label">JOD Account Number:</td>
            <td class="info-value">{!jodAccountNumber}</td>
        </tr>
        <tr>
            <td class="info-label">Active Requests:</td>
            <td class="info-value">{!activeCount}</td>
            <td class="info-label">Expired Requests:</td>
            <td class="info-value">{!expiredCount}</td>
        </tr>
    </table>

    <div class="section-title">Active Report Requests</div>
    <apex:outputPanel rendered="{!activeCount > 0}">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Report Status</th>
                    <th>Request Date and Time</th>
                    <th>Reference Number</th>
                    <th>Expiry Date</th>
                </tr>
            </thead>
            <tbody>
                <apex:repeat value="{!activeReports}" var="report">
                    <tr>
                        <td>
                            <span class="status-badge {!report.statusClass}">
                                {!report.statusLabel}
                            </span>
                        </td>
                        <td>{!report.formattedGenerateDate}</td>
                        <td>{!report.data.refNo}</td>
                        <td>{!report.data.expiryDate}</td>
                    </tr>
                </apex:repeat>
            </tbody>
        </table>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!activeCount == 0}">
        <div class="empty-msg">No active CRIF reports found.</div>
    </apex:outputPanel>

    <div class="section-title">Expired Report Requests</div>
    <apex:outputPanel rendered="{!expiredCount > 0}">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Report Status</th>
                    <th>Request Date and Time</th>
                    <th>Reference Number</th>
                    <th>Expiry Date</th>
                </tr>
            </thead>
            <tbody>
                <apex:repeat value="{!expiredReports}" var="report">
                    <tr>
                        <td><span class="status-badge {!report.statusClass}">{!report.statusLabel}</span></td>
                        <td>{!report.formattedGenerateDate}</td>
                        <td>{!report.data.refNo}</td>
                        <td>{!report.data.expiryDate}</td>
                    </tr>
                </apex:repeat>
            </tbody>
        </table>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!expiredCount == 0}">
        <div class="empty-msg">No expired CRIF reports found.</div>
    </apex:outputPanel>
</body>
</html>
</apex:page>