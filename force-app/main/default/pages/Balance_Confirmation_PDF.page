<apex:page applyHtmlTag="false" showHeader="false" Controller="LetterGenerationController" renderAs="pdf">
    <head>
        <style type="text/css">
            
            @page {
            	margin: 50px .5in 1in .5in;
            	margin-bottom:80px;
            	@bottom-center {
            		content: element(footer)
            	}
            }
            body {
                /* font-family: Arial Unicode MS; */
                font-family: 'Open Sans', Inter, sans-serif;
                font-size: 8px;
                margin: 10px;
            }
            
           
            
            table, td, th {
              border: 1px solid;
            }
            table {
            	border-collapse: collapse;
            }
            .topmargin20 {
                margin-top:15px;
            }
            div.footer {
                    display: block;
                    position: running(footer);
                    width:100%;
                }
            
            .repeatTableHeader{-fs-table-paginate: paginate;}
        </style>
    </head>
    <!-- <body style="font-family: Arial Unicode MS"> -->
     <body style="font-family: 'Open Sans', Inter, sans-serif;">
        <div class="headerTitle">
        
            <apex:outputPanel rendered="{!isAlburaq}">
                <table width="100%">
                    <tr>
                        <td align="left" style="border:0px;">
                            <apex:image url="{!$Resource.ila_logo_pdf}" width="60"/>
                        </td>
                        <td align="right" style="border:0px;">
                                <apex:image url="{!$Resource.alburaq_logo_pdf}" width="170"/>
                        </td>
                    </tr>
                </table>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!!isAlburaq}">
                <div style="width:100%;text-align:right">
                    <apex:image url="{!$Resource.ila_logo_vf}" width="100"/>
                </div>
            </apex:outputPanel>
        <div style="margin-top:14px;font-size:14px">
            <p>
                Ref: {!caseNumber}
            </p>
            <p>Date:&nbsp;<apex:outputText value="{0, date,  dd/MM/yyyy}"><apex:param value="{!letterDate}" /></apex:outputText></p>
            <p>To: {!gender}.{!acc.Name},</p>
            <p>
                &nbsp;&nbsp;&nbsp;{!acc.PersonMailingStreet}<br/>
                &nbsp;&nbsp;&nbsp;{!acc.PersonMailingCity} {!acc.PersonMailingState}<br/>
                &nbsp;&nbsp;&nbsp;{!acc.PersonMailingPostalCode}<br/>
                &nbsp;&nbsp;&nbsp;{!acc.PersonMailingCountry}
            </p>
        </div>
    
        <div style="font-size:14px;">
            Dears,   
        </div>
        <div style="text-align:center;text-decoration:underline;margin-top:15px;font-size:16px;">
        	Subject: Balance Confirmation    
        </div>
        <div style="margin-top:30px;font-size:14px;">
            <div>
                This is to certify that <span style="text-decoration:underline;text-transform:uppercase">{!gender}.{!acc.Name},</span> holder of Identity Card number [{!cc_ID_Number}], has been banking with ila Bank since <apex:outputText value="{0, date,  dd/MM/yyyy}"><apex:param value="{!acc.Bank_Account_Opening_Date__c}" /></apex:outputText>. The Customer currently maintains the below detailed accounts with the Bank. The total balance reflects the combined total of his eligible accounts, including savings, and any other applicable accounts excluding government securities (Treasury Bills, Bonds, Hassala, Fixed Deposits, etc)
            </div>
            
            <div>&nbsp;</div>
            <table align="center" border="1" style="border-collapse: collapse;width:90%;max-height:350px;">
                <tr style="height:30px;">
                    <th align="center">No</th>
                    <th align="center">Account/IBAN No.</th>
                    <th align="center">Account Type</th>
                    <th align="center">Currency</th>
                    <th align="center">Balance</th>
                </tr>
                <apex:repeat value="{!accDetails}" var="accObj">
                    <tr style="height:30px;">
                        <td align="center">{!accObj.increment}</td>
                        <td align="center">{!accObj.accIban}</td>
                        <td align="center">{!accObj.accType}</td>
                        <td align="center">{!accObj.accCurrency}</td>
                        <td align="center">{!accObj.balance}</td>
                    </tr>
                </apex:repeat>
            </table>
        </div>
       <!-- <div>&nbsp;</div> -->
    	<div style="margin-top:25px;font-size:14px">
            <p>
                The above-mentioned balances are as of <apex:outputText value="{0, date,  dd/MM/yyyy}"><apex:param value="{!letterDate}" /></apex:outputText> and are subject to withdrawal at any time in accordance with the Bank’s prevailing Terms and Conditions.
            </p>
            <p>
                This certificate has been issued at the request of the Customer and without any responsibility, financial obligation and/or liability on the part of the Bank, its employees or any of its directors.
            </p>
            <p>
                Should there be any further questions, kindly contact us on +973 1712345 or you can send an email to support@ilabank.com
            </p>
            <p>
                Yours Faithfully,
            </p>
            <div>
                <div style="border-bottom:1px solid black;width:200px">&nbsp;</div>
                <div>For and on behalf of <br/>Ila Bank</div>
            </div>
        </div>
        
            </div>
        <div style="height:15px">
            &nbsp;
        </div>
        <apex:outputPanel rendered="{!isAlburaq}">
            <div style="text-align:center;width:100%;">
                <apex:image url="{!$Resource.alburaq_border_pdf_logo}" width="140"/>
            </div>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!!isAlburaq}">
                <div style="width:100%;text-align:center">
                    <apex:image url="{!$Resource.ilaLogo}" width="100"/>
                </div>
       	</apex:outputPanel>
        <div class="footer" style="page-break-after:always;width:800px"><!--position:fixed;bottom:0px;width:100%;-->
            <table style="font-size:8px;width:100%;color:#999999;">
            <tr>
            	<td width="50%" style="border:0px">
                	<p>T +97317543000<br/>www.ilabank.com</p>
                </td>
                <td width="50%"  style="border:0px">
                	<p>
                        <strong>Head Office</strong><br/>
                        P.O. Box 5698, Manama, Kingdom of Bahrain (CR: 10299-2)<br/>
                        Licensed as a Conventional Retail Bank - Branch by the Central Bank of Bahrain<br/>
                        Powered by Bank ABC (Arab Banking Corporation B.S.C.)
                    </p>
                </td>
            </tr>
        </table>
        </div>
    </body>
</apex:page>