            <script>
            function checkPhone(){
                console.log('Number Change at UI');
                var mobile = document.getElementById("j_id0:fmId:reqPhone").value;
                var countryCode = document.getElementById("j_id0:fmId:select-phonecode").value;
                
                if(countryCode == '+973' || countryCode == '+965' || countryCode == '+968' || countryCode == '+974'){
                    console.log('Mobile Length:'+mobile.length);
                    if(mobile.length != 8){
                        document.getElementById("err1").innerHTML = "Mobile Number must be 8 digits.";
                        document.getElementById("j_id0:fmId:btnid").style.display = 'none';
                    }
                    else{
                        document.getElementById("err1").innerHTML= "";
                        document.getElementById("j_id0:fmId:btnid").style.display = 'inline';
                    }
                }
                if(countryCode == '+966' || countryCode == '+971'){
                    if(mobile.length != 9){
                        document.getElementById("err1").innerHTML = "Mobile Number must be 9 digits.";
                        document.getElementById("j_id0:fmId:btnid").style.display = 'none';
                    }
                    else{
                        document.getElementById("err1").innerHTML= "";
                        document.getElementById("j_id0:fmId:btnid").style.display = 'inline';
                    }
                }
               
            }
        </script>
