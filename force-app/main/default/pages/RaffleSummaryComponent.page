<apex:page showHeader="false" sidebar="false" applyBodyTag="false" applyHtmlTag="false" standardStylesheets="false" controller="RaffleSummaryController">

    <head>
        <apex:includeScript value="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js" />
        <apex:includeScript value="http://cdnjs.cloudflare.com/ajax/libs/ocanvas/2.10.0/ocanvas.min.js" />
        <apex:includeScript value="{!URLFOR($Resource.Raffles, 'Raffles/index.js')}"></apex:includeScript>
        <apex:stylesheet value="{!URLFOR($Resource.Raffles, 'Raffles/style3.css')}" />
        <style>
        @font-face{
          font-family: Neo Sans Arabic;
          src: url("{!URLFOR($Resource.Raffles, 'Raffles/fonts/NeoSansArabic.ttf')}") format('truetype');
        }
        
        @font-face{
          font-family: SF Pro Text;
          src: url("{!URLFOR($Resource.Raffles, 'Raffles/fonts/SF-Pro-Text-Regular.otf')}") format('opentype');
        }
        </style>
    </head>

    <body>
        <div id="container">
            <!--<canvas id="canvas"> </canvas>-->
            <div id="controls">
                <div class="main">

                    <div class="logo">
                        <apex:image styleClass="ila-logo" url="{!URLFOR($Resource.Raffles, 'Raffles/images/logo.png')}" />
                    </div>

                    <div class="big-title">
                        {!drawName}
                    </div>
                    <div class="winner-boxes">
                        <apex:repeat value="{!summaryList}" var="element" id="repeatSummary">
                            <div class="winner-box">
                                <dev class="prize-desc">
                                    <!-- #CH01: Start -->
                                    <span>{! 'Prize: ' + element.prizeName }</span>

                                    <!-- <span>{!element.prizeName + ' ' + element.currencyValue}</span>
                                    <span>
                                        <apex:outputText value="{0, number, ###,##0}" id="myNumberDisplay">
                                            <apex:param value="{!element.winningAmmount}" />
                                        </apex:outputText>
                                    </span> -->
                                    
                                    <!-- #CH01: End -->
                                </dev>
                                <apex:repeat value="{!element.winnerList}" var="winnerElement" id="elementRepeat">
                                    <dev>
                                        <apex:outputPanel rendered="{! winnerElement.Customer__r.iGA_English_First_Name__pc != null && winnerElement.Customer__r.iGA_English_Last_Name__pc != null}">
                                            <span class="winner-name">{!winnerElement.Customer__r.iGA_English_First_Name__pc} {!winnerElement.Customer__r.iGA_English_Last_Name__pc + ' - ' + winnerElement.Customer_CIF__c} </span>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{! winnerElement.Customer__r.iGA_English_First_Name__pc == null || winnerElement.Customer__r.iGA_English_Last_Name__pc == null}">
                                            <span class="winner-name">{!winnerElement.Customer__r.Name + ' - ' + winnerElement.Customer_CIF__c}</span>
                                        </apex:outputPanel>
                                    </dev>
                                </apex:repeat>
                            </div>
                        </apex:repeat>
                    </div>
                </div>

            </div>
        </div>
    </body>
</apex:page>