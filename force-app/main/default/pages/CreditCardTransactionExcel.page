<apex:page controller="creditCardPdfController2" readOnly="true" contentType="application/vnd.ms-excel;charset=UTF-8" standardStylesheets="false" showHeader="false">
	<head>
        <style>
        	table, td, th {
              border: 1px solid #cccccc;
            }
            table {
            	border-collapse: collapse;
            }
        </style>
    </head>
    <body>
        
        <!--Header title -->
        <table>
            <tr>
            	<td></td>
                <td colspan="2"><h2>{!decodedCardType}</h2></td>
            </tr>
        </table>
        
        <!--Customer Details -->
        <table>
            <tr>
            	<td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
            	<td></td>
                <td><h3>CUSTOMER INFORMATION</h3></td>
                <td></td>
            </tr>
            <tr>
            	<td></td>
                <td><b>Customer Name</b></td>
                <td>{!decodedaccName}</td>
            </tr>
            <tr>
            	<td></td>
                <td><b>Customer CIF</b></td>
                <td style="mso-number-format: '\@'">{!decodedcustomerId}</td>
            </tr>
            <tr>
            	<td></td>
                <td><b>Card Number</b></td>
                <td>{!maskedCardNo}</td>
            </tr>
            <tr>
            	<td></td>
                <td><b>Unit</b></td>
                <td>Ila</td>
            </tr>
            <apex:outputPanel rendered="{!isFromDateIncludedInFilter}">
            <tr>
            	<td></td>
                <td><b>From Date</b></td>
                <td style="mso-number-format: '\@'">{!fromDate}</td>
            </tr>
            <tr>
            	<td></td>
                <td><b>To Date</b></td>
                <td style="mso-number-format: '\@'">{!toDate}</td>
            </tr>
            </apex:outputPanel>
            <tr>
            	<td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
            	<td></td>
                <td></td>
                <td></td>
            </tr>
        </table>
        
        <!-- Card Transactions -->
        <table>
            <tr>
            	<th>Sno</th>
                <th>Transaction Date</th>
            	<th>Type</th>
            	<th>Status</th>
            	<th>Amount</th>
            	<th>Currency</th>
            	<th>Description</th>
                <th>Earned Token</th>
                <th>Reference</th>
            </tr>
            <apex:variable value="{!1}" var="count"/>
            <apex:repeat value="{!transactionList}" var="transaction">
                <tr>
                 <td style="mso-number-format: '\@';text-align:center">{!FLOOR(count)} </td>
                 <td style="mso-number-format: '\@'">{!transaction.transactionDate}</td>
                 <td style="mso-number-format: '\@'">{!transaction.transactionType}</td>
                 <td>{!transaction.status}</td>
                 <td>{!transaction.originalAmount}</td>
                 <td>{!transaction.originalCurrency.code}</td>
                 <td>{!transaction.transactionDescription1}</td>
                 <td></td>
                 <td style="mso-number-format: '\@'">{!transaction.transactionReference}</td> 
               </tr>
               <apex:variable var="count" value="{!count+ 1}"/>
            </apex:repeat>
        </table>
    </body>
</apex:page>