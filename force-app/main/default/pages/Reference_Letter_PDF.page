<apex:page applyHtmlTag="false" showHeader="false" Controller="LetterGenerationController" renderAs="advanced_pdf">
    <head>
        <style type="text/css">
            
            body {
                /* font-family: Arial Unicode MS; */
                font-family: 'Open Sans', Inter, sans-serif;
                font-size: 8px;
                margin: 10px;
            }
            
            @page {
                margin-top: 1cm;
                margin-bottom: 2cm;
                margin-left: 1cm;
                margin-right: 1cm;
                
                @top-center {
                    content: element(headerTitle);
                }
                div.headerTitle {
                    position: running(headerTitle);
                }
            
                @bottom-left {
                    content: element(footer);
                }
            }
            
            table, td, th {
              border: 0px solid;
            }
            table {
                border-collapse: collapse;
            }
            .topmargin20 {
                margin-top:15px;
            }
            div.footer {
                    display: block;
                    position: running(footer);
                    width:100%;
                }
            
            .repeatTableHeader{-fs-table-paginate: paginate;}
        </style>
    </head>
    <!-- <body style="font-family: Arial Unicode MS"> -->
     <body style="font-family: 'Open Sans', Inter, sans-serif;">
        
        <div class="headerTitle">
        
        <apex:outputPanel rendered="{!isAlburaq}">
                <table width="100%">
                    <tr>
                        <td align="left" style="border:0px;">
                            <apex:image url="{!$Resource.ila_logo_pdf}" width="60"/>
                        </td>
                        <td align="right" style="border:0px;">
                                <apex:image url="{!$Resource.alburaq_logo_pdf}" width="170"/>
                        </td>
                    </tr>
                </table>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!!isAlburaq}">
                <div style="width:100%;text-align:right">
                    <apex:image url="{!$Resource.ila_logo_vf}" width="100"/>
                </div>
            </apex:outputPanel>
        
        <div style="text-align:center;margin-top:15px;font-size:18px;">
            <p>TO WHOM IT MAY CONCERN</p>    
        </div>
        <div style="text-align:center;text-decoration:underline;margin-top:15px;font-size:16px;">
            Reference Letter    
        </div>
        <div style="margin-top:35px;font-size:14px">
           
            <p style="line-height:1.8">
                <b>Ref</b>: {!caseNumber}<br/>
                <b>Date</b>:&nbsp;<apex:outputText value="{0, date,  dd/MM/yyyy}"><apex:param value="{!letterDate}" /></apex:outputText><br/>
                <b>Name</b>: {!gender}.{!acc.Name}<br/>
                <b>National ID no</b>: {!cc_ID_Number}<br/>
                <b>IBAN</b>: {!ac_Iban}<br/>
                <b>Registered Address</b>:<br/>
                &nbsp;&nbsp;&nbsp;{!acc.PersonMailingStreet}<br/>
                &nbsp;&nbsp;&nbsp;{!acc.PersonMailingCity} {!acc.PersonMailingState}<br/>
                &nbsp;&nbsp;&nbsp;{!acc.PersonMailingPostalCode}<br/>
                &nbsp;&nbsp;&nbsp;{!acc.PersonMailingCountry}
            </p>    
        </div>
            <br/>
        <div style="margin-top:14px;font-size:14px">
            <p style="line-height:1.5">
                This letter is to certify that Mr/Mrs <b>{!gender}.{!acc.Name}</b> is a well know customer to ila bank and has been maintaining a satisfactory relationship since <apex:outputText value="{0, date,  dd/MM/yyyy}"><apex:param value="{!acc.Bank_Account_Opening_Date__c}" /></apex:outputText>
                <br/><br/>This certificate has been issued as per the request of the customer and without any liability from ila Bank's part. 
                <br/><br/>Should there be any further questions, kindly contact us on +973 1712345
            </p>
        </div>
        
            </div>
        <div style="font-size:14px">
            <br/><br/><br/>Yours Sincerely<br/>Ila Bank
        </div>
        <apex:outputPanel rendered="{!isAlburaq}">
            <div style="text-align:center;width:100%;">
                <apex:image url="{!$Resource.alburaq_border_pdf_logo}" width="140"/>
            </div>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!!isAlburaq}">
                <div style="width:100%;text-align:center">
                    <apex:image url="{!$Resource.ilaLogo}" width="100"/>
                </div>
        </apex:outputPanel>
        <div style="position:fixed;bottom:0px;width:100%;">
            <table style="font-size:8px;width:100%;color:#999999;border:0px" border="0">
            <tr>
                <td width="50%" valign="bottom">
                    <p>T +97317543000<br/>www.ilabank.com</p>
                </td>
                <td width="50%">
                    <p>
                        <strong>Head Office</strong><br/>
                        P.O. Box 5698, Manama, Kingdom of Bahrain (CR: 10299-2)<br/>
                        Licensed as a Conventional Retail Bank - Branch by the Central Bank of Bahrain<br/>
                        Powered by Bank ABC (Arab Banking Corporation B.S.C.)
                    </p>
                </td>
            </tr>
        </table>
        </div>
    </body>
</apex:page>