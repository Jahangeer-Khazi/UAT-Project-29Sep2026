        <sharedTo>
            <group>Credit_Retail_Team_Jordan</group>
        </sharedTo>
        <criteriaItems>
            <field>Region_Flag__c</field>
            <operation>equals</operation>
            <value>Jordan</value>
        </criteriaItems>
        <criteriaItems>
            <field>Scan_Type__c</field>
            <operation>equals</operation>
            <value>Credit Card Application,Credit Card Supplementary Application</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Non_CreditCard_Documents_Bahrain</fullName>
