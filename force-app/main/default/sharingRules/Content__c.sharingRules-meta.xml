<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Credit_Card_Documents</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This sharing rule enables the sharing for the documents Retail Credit team fro &quot;Credit Card related application&quot;</description>
        <label>Credit Card Documents</label>
        <sharedTo>
            <group>Credit_Retail_Team</group>
        </sharedTo>
        <criteriaItems>
            <field>Scan_Type__c</field>
            <operation>equals</operation>
            <value>Credit Card Application,Credit Card Supplementary Application</value>
        </criteriaItems>
        <criteriaItems>
            <field>Region_Flag__c</field>
            <operation>equals</operation>
            <value>Bahrain</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Credit_Card_Documents_JORDAN</fullName>
