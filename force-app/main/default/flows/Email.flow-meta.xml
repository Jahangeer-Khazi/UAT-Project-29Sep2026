	CONTAINS(LOWER({!myVariable_current.ToAddress}), &apos;supportjo@&apos;),
	CONTAINS(LOWER({!myVariable_current.CcAddress}), &apos;supportjo@&apos;)
)
)</expression>
    </formulas>
