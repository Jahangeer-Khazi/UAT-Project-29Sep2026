        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND
(
ISNEW(),
OR(
	CONTAINS(LOWER([EmailMessage].ToAddress), &apos;supportjo@&apos;),
	CONTAINS(LOWER([EmailMessage].ccAddress), &apos;supportjo@&apos;)
)
) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND
(
