                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_History_Object</targetReference>
            </connector>
            <label>Message Updated</label>
        </rules>
    </decisions>
    <description>This flow would create a history record when Message field gets changes, as textarea field cannot be tracked through history tracking.</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula field would check if the Message field is got changed or not.</description>
        <name>IsMessageChanged</name>
        <dataType>Boolean</dataType>
        <expression>TRIM({!$Record__Prior.Message__c}) &lt;&gt; TRIM({!$Record.Message__c})</expression>
    </formulas>
