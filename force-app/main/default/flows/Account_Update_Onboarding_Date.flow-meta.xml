    <description>updating the Underage value to 27 years (in UAT)</description>
    <environments>Default</environments>
    <formulas>
        <name>Birthday18YearsDateFormula</name>
        <dataType>Date</dataType>
        <expression>DATE ( 
YEAR( {!$Record.PersonBirthdate}) +27,
MONTH({!$Record.PersonBirthdate}),
DAY({!$Record.PersonBirthdate})
 )</expression>
    </formulas>
