    <decisions>
        <description>If Checker assigned request back to Maker , Owner will be RM Maker Queue</description>
        <name>If_Checker_Result_is_Return_to_Maker</name>
        <label>If Checker Result is Return to Maker</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>If_Maker_Result_is_Send_to_Checker</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Return_to_Maker</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Checker_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Return to Maker</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Checker_Result__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Return to Maker</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_To_RM_Maker_Queue_Members_If_Assigned_Back</targetReference>
            </connector>
            <label>Yes - Return to Maker</label>
        </rules>
    </decisions>
    <decisions>
        <description>If Group Member Belongs to RM Maker Queue</description>
        <name>If_Group_Member_Belongs_to_RM_Maker_Queue</name>
        <label>If Group Member Belongs to RM Maker Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Group_Member_to_RM_Checker_User_Id_Collections</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>RM checker Queue</defaultConnectorLabel>
        <rules>
            <name>Yes_RM_Maker_Queue_Member</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_on_Group_Members.GroupId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Var_RMMakerQueueId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Group_Member_to_RM_Maker_User_Id_Collections</targetReference>
            </connector>
            <label>Yes - RM Maker Queue Member</label>
        </rules>
    </decisions>
    <decisions>
        <description>If Maker assigned the record to checker , Picklist value of Maker comment is Send to checker owner will be Assigned to RM checker Queue</description>
        <name>If_Maker_Result_is_Send_to_Checker</name>
        <label>If Maker Result is Send to Checker</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Send_to_Checker</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Maker_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Send to Checker</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Maker_Result__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Send to Checker</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_To_RM_Checker_Queue_Members</targetReference>
            </connector>
            <label>Yes - Send to Checker</label>
        </rules>
    </decisions>
    <decisions>
