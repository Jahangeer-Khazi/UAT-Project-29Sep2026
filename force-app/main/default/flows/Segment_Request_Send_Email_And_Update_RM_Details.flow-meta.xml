    <decisions>
        <description>If Segment Request is Approved , Update RM Id and RM Name on Customer Record</description>
        <name>If_Segment_Request_is_Approved</name>
        <label>If Segment Request is Approved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
