                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_status_and_subStatus</targetReference>
            </connector>
            <label>Approve-CheckerResult</label>
        </rules>
        <rules>
            <name>Decline_CheckerResult</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckerResultIsChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
