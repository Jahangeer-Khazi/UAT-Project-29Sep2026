    <decisions>
        <description>Customer segment and RM Segment should match. If not matched record should not be saved</description>
        <name>Validation_rule_to_check_customer_segment</name>
        <label>Validation rule to check customer segment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Please_select_the_correct_RM_as_the_Segment_applicable_do_not_match</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Different Segment</defaultConnectorLabel>
        <rules>
            <name>YES_Same_Segment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NewRMID__r.Segments__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Contact_Name__r.Segment__pc</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Owner_to_RM_Maker_Queue</targetReference>
            </connector>
            <label>YES - Same Segment</label>
        </rules>
    </decisions>
    <decisions>
        <description>If Present RM on customer is same as new customer , user should not be able to create RM Request</description>
        <name>Validation_Rule_to_check_Old_RM_And_Current_RM</name>
        <label>Validation Rule to check Old RM And Current RM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Validation_rule_to_check_customer_segment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NO - Different  RM Request</defaultConnectorLabel>
        <rules>
            <name>YES_Same_RM</name>
            <conditionLogic>1 OR ( 2 AND 3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact_Name__r.RM_ID__pc</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.NewRMID__r.RM_ID__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact_Name__r.RM_Name__pc</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NewRMID__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NewRMID__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>None</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_Current_RM_And_New_RM_Same</targetReference>
            </connector>
            <label>YES - Same  RM</label>
        </rules>
    </decisions>
