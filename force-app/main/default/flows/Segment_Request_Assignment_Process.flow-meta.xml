    <decisions>
        <description>If Checker Result Picklist value is Return to Maker , Approve and Reject.Update the Status,Substatus,Closure Date and owner</description>
        <name>If_Checker_Value_Selected</name>
        <label>If Checker Value Selected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>If_Maker_Value_is_Send_to_Checker</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Checker_Value_Exist</name>
            <conditionLogic>(1 AND 4) OR (2 AND 5) OR (3 AND 6)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Checker_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Return to Maker</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Checker_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Checker_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Checker_Result__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Return to Maker</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Checker_Result__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Checker_Result__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_Checker_Value_is_Return_to_Maker</targetReference>
            </connector>
            <label>Yes-Checker Value Exist</label>
        </rules>
    </decisions>
