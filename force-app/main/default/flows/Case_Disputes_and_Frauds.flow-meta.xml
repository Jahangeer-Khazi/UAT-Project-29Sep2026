OR(
AND(ISPICKVAL({!caseRecord.Sub_Type__c},&quot;ATM&quot;),
OR(
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Did not receive cash from ATM&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Partial Amount Dispensed&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Financial Impact - Fraudulent / Unauthorized&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;No Financial Impact - Fraudulent/Unauthorized&quot;)
)
),
AND(ISPICKVAL({!caseRecord.Sub_Type__c},&quot;POS / E-Commerce&quot;),
OR(
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Transaction did not go through&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Duplicate payment&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Purchased goods not received&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Transaction amount differs.&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Late posted transaction&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Refund not processed&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Service Not Provided&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Other (Specify in description)&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Financial Impact - Fraudulent / Unauthorized&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;No Financial Impact - Fraudulent/Unauthorized&quot;)
)
)
)
),
AND(
ISPICKVAL({!caseRecord.Type},&quot;MasterCard&quot;),
OR(
AND(ISPICKVAL({!caseRecord.Sub_Type__c},&quot;ATM&quot;),
OR(
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Did not receive cash from ATM&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Partial Amount Dispensed&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Financial Impact - Fraudulent / Unauthorized&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;No Financial Impact - Fraudulent/Unauthorized&quot;)
)
),
AND(ISPICKVAL({!caseRecord.Sub_Type__c},&quot;POS / E-Commerce&quot;),
OR(
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Transaction did not go through&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Duplicate payment&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Purchased goods not received&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Transaction amount differs.&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Late posted transaction&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Refund not processed&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Service Not Provided&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Other (Specify in description)&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Financial Impact - Fraudulent / Unauthorized&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;No Financial Impact - Fraudulent/Unauthorized&quot;)
)
)
)
)
)
)</expression>
    </formulas>
    <formulas>
        <name>isFraudQueueConditionTwo</name>
        <dataType>Boolean</dataType>
        <expression>AND(
OR(
AND(
ISPICKVAL({!caseRecord.Type},&quot;EFTs&quot;),
OR(
AND(
OR(
ISPICKVAL({!caseRecord.Sub_Type__c},&quot;Fawri&quot;),
ISPICKVAL({!caseRecord.Sub_Type__c},&quot;Fawri+&quot;),
ISPICKVAL({!caseRecord.Sub_Type__c},&quot;Fawateer&quot;)
),
OR(
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;Financial Impact - Fraudulent / Unauthorized&quot;),
ISPICKVAL({!caseRecord.cc_Request_Type__c},&quot;No Financial Impact - Fraudulent/Unauthorized&quot;)
)
)
)
),
AND(
ISPICKVAL({!caseRecord.Type},&quot;SWIFT&quot;),
OR(
ISPICKVAL({!caseRecord.Sub_Type__c},&quot;Fraudulent/Unauthorized&quot;)
)
)
)
)</expression>
