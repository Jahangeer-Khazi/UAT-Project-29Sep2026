            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>oldCaseRecord.cc_Maker__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>caseRecord.cc_Maker__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>caseRecord.cc_Maker__c</leftValueReference>
                <operator>EqualTo</operator>
