    <decisions>
        <name>Check_Checker_Result_is_Changed</name>
        <label>Check Checker Result is Changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Changed_to_Approve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseRecord.cc_Checker_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>oldCaseRecord.cc_Checker_Result__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>caseRecord.cc_Checker_Result__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Questionnaire_Approved_Email</targetReference>
            </connector>
            <label>Yes, Changed to Approve</label>
        </rules>
        <rules>
            <name>Yes_Changed_to_Reject</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseRecord.cc_Checker_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>oldCaseRecord.cc_Checker_Result__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>caseRecord.cc_Checker_Result__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Questionnaire_Rejected_Email</targetReference>
            </connector>
            <label>Yes, Changed to Reject</label>
        </rules>
    </decisions>
