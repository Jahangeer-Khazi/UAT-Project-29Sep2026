<?xml version="1.0"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
	<apiVersion>63.0</apiVersion>
	<description>This component would show a customized case related list.</description>
	<isExposed>true</isExposed>
	<targets>
		<target>lightning__RecordPage</target>
	</targets>
	<targetConfigs>
		<targetConfig targets="lightning__RecordPage">
			<property name="relatedListTitle" label="Related List Title" type="String" required="true"/>
			<property name="caseRecordType" label="Case Record Type" type="String" datasource="Credit_Card,Loan_Application" required="true"/>
		</targetConfig>
	</targetConfigs>
</LightningComponentBundle>