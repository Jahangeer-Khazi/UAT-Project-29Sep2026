<?xml version="1.0" encoding="UTF-8"?>
<QuickAction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This case will be initiated for the Compliance Exit Recommendation process</description>
    <fieldOverrides>
        <field>AccountId</field>
        <formula>Account.Id</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Case_Model__c</field>
        <formula>IF(TEXT(Account.PersonContact.Subscription_Model__c) = &quot;alburaq&quot; , &quot;alburaq&quot; , &quot;ila&quot;)</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Case_Nature__c</field>
        <formula>&quot;EXIT&quot;</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Compliance_Alert__c</field>
        <formula>true</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>ContactId</field>
        <formula>Account.PersonContactId</formula>
    </fieldOverrides>
