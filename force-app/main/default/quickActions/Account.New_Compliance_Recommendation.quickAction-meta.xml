        <field>Description</field>
        <formula>&quot;Please refer to the case content&quot;</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Origin</field>
        <literalValue>CRM</literalValue>
    </fieldOverrides>
    <fieldOverrides>
        <field>Status</field>
        <literalValue>New</literalValue>
    </fieldOverrides>
    <fieldOverrides>
        <field>Subject</field>
        <formula>&quot;Compliance Recommendation&quot;</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Type</field>
        <formula>&quot;Compliance&quot;</formula>
        <literalValue>Compliance</literalValue>
    </fieldOverrides>
