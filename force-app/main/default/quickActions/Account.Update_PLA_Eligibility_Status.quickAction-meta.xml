<?xml version="1.0" encoding="UTF-8"?>
<QuickAction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Used to create a case if staff would like to update PLA Eligibility Status for a Customer</description>
    <fieldOverrides>
