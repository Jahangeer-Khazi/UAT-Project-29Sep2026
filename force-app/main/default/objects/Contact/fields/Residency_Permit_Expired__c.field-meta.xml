<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Residency_Permit_Expired__c</fullName>
    <formula>IF(
   AND(Nationality__c != &apos;BH&apos;,
          OR(ISBLANK(Residency_Permit_Expiry__c),
          Residency_Permit_Expiry__c &lt;= TODAY()
          )
   ),true,false)</formula>
    <label>Residency Permit Expired</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
