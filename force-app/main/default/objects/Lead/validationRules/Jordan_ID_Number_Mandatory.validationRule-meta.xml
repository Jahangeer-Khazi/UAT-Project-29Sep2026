<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Jordan_ID_Number_Mandatory</fullName>
    <active>true</active>
    <description>Jordan ID Number field is mandatory if Nationality equals Jordan</description>
    <errorConditionFormula>AND( 
				NOT($Setup.Setting__c.Bypass_Validation_Rules__c),
				ISPICKVAL(Region_Flag__c, &quot;Jordan&quot;),
				ISPICKVAL(Nationality__c, &quot;JO&quot;),  
				ISBLANK(ID_Number_2__c) 
)</errorConditionFormula>
    <errorMessage>Please fill the customer&apos;s Jordan ID Number to proceed</errorMessage>
</ValidationRule>
