<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ID_Expiry_Date_Validations</fullName>
    <active>true</active>
    <errorConditionFormula>Address_ID_Expiry_Date__c &lt; TODAY() ||  ID_Expiry_Date__c &lt; TODAY()</errorConditionFormula>
