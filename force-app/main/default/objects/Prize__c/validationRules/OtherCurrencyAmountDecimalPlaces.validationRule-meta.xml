<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OtherCurrencyAmountDecimalPlaces</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
				!ISPICKVAL(Draw__r.Currency__c, &apos;BHD&apos;),
    Winning_Amount__c &lt;&gt; ROUND(Winning_Amount__c, 2) 
 )</errorConditionFormula>
    <errorDisplayField>Winning_Amount__c</errorDisplayField>
    <errorMessage>Max decimal places for this prize currency is 2</errorMessage>
</ValidationRule>
