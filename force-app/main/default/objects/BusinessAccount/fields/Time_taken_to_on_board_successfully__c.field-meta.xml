<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Time_taken_to_on_board_successfully__c</fullName>
    <description>This field calculates the Time taken in Minutes by Customer to on board successfully,</description>
    <externalId>false</externalId>
    <formula>IF(NOT(ISBLANK(Bank_Account_Opening_Date__c)), ( Bank_Account_Opening_Date__c  - CreatedDate)*24*60, null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>In minutes</inlineHelpText>
    <label>Time taken to on-board successfully</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
