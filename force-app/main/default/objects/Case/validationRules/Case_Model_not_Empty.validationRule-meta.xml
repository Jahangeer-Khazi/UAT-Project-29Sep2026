<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Model_not_Empty</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($Setup.Setting__c.Bypass_Validation_Rules__c),
ISBLANK(TEXT(Case_Model__c)))</errorConditionFormula>
    <errorMessage>Case Model on the Case record is empty. Please contact your administrator.</errorMessage>
</ValidationRule>
