<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BenefitPay_GuardingCIFMustBeNumeric</fullName>
    <active>false</active>
    <errorConditionFormula>REGEX( Guardian_CIF__c ,&quot;^[a-z A-Z]*$&quot;)</errorConditionFormula>
    <errorDisplayField>Guardian_CIF__c</errorDisplayField>
    <errorMessage>Guardian CIF should be Numeric</errorMessage>
</ValidationRule>
