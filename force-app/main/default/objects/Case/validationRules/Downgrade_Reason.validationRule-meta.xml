<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Downgrade_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(cc_Contact_Centre_Result__c,&quot;Downgrade&quot;),
 ISPICKVAL(Downgrade_Reason__c,&quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>Downgrade_Reason__c</errorDisplayField>
    <errorMessage>Downgrade Reason is mandatory if contact center result is Downgrade</errorMessage>
</ValidationRule>
