<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>segmentChange_forOnlyalburaq</fullName>
    <active>true</active>
    <description>The case of recordType &quot;Service_Request&quot; and subType = &quot;alburaq segment change&quot; ,could be used for only alburaq customer</description>
    <errorConditionFormula>RecordType_DeveloperName__c == &apos;Service_Request&apos;  &amp;&amp; 
TEXT(Sub_Type__c) == &apos;Alburaq Segment Change&apos; &amp;&amp;
TEXT(Contact.Subscription_Model__c) != &apos;alburaq&apos;</errorConditionFormula>
    <errorDisplayField>Sub_Type__c</errorDisplayField>
    <errorMessage>This value can be used for only alburaq customers</errorMessage>
</ValidationRule>
