<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_Downgrade_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Downgrade_Reason__c,&apos;Other&apos;),
  ISNULL(Other_Downgrade_Reason__c))</errorConditionFormula>
    <errorDisplayField>Other_Downgrade_Reason__c</errorDisplayField>
    <errorMessage>Other Downgrade Reason is mandatory if selected “Downgrade Reason” is “Other“</errorMessage>
</ValidationRule>
