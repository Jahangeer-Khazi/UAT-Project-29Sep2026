<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Loans_Signature_Verifier_Result_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
				($User.LastName &lt;&gt; &quot;Integration&quot;),
    RecordType_DeveloperName__c = &apos;Loan_Application&apos;,
				ISCHANGED(cc_Signature_Verifier_Result__c),
				ISPICKVAL(cc_Signature_Verifier_Result__c, &apos;Accept&apos;),
				!ISPICKVAL(Sub_Status__c, &apos;Pending Signature Verification&apos;)
)</errorConditionFormula>
    <errorDisplayField>cc_Signature_Verifier_Result__c</errorDisplayField>
    <errorMessage>Please Accept only once the sub status is changed to &quot;Pending Signature Verification&quot;</errorMessage>
</ValidationRule>
