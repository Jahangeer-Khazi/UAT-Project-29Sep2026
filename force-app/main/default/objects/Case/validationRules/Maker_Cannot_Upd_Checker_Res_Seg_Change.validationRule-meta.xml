<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Maker_Cannot_Upd_Checker_Res_Seg_Change</fullName>
    <active>false</active>
    <description>This validation will fire if Maker is updating the checker result for the Segment Change Project</description>
    <errorConditionFormula>AND(
ISPICKVAL(Type , &quot;Account&quot;),
ISPICKVAL(Sub_Type__c, &quot;Segment&quot;),
ISCHANGED(cc_Checker_Result__c),
NOT(ISPICKVAL(cc_Checker_Result__c, &quot;&quot;)),
(Address_Updated_By__c = $User.Id),
($User.LastName &lt;&gt; &quot;Integration&quot;)
)</errorConditionFormula>
    <errorDisplayField>cc_Checker_Result__c</errorDisplayField>
    <errorMessage>Maker cannot able to select Checker Result.</errorMessage>
</ValidationRule>
