<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>cx_ln_Cross_Selling_isCancelOrDecline__c</fullName>
    <formula>OR(
    OR (ISPICKVAL(cx_ln_Cross_Selling_PreScreening_Result__c, &apos;Decline&apos;),ISPICKVAL(cx_ln_Cross_Selling_PreScreening_Result__c, &apos;Cancelled&apos;) ),
    OR (ISPICKVAL(cx_ln_Cross_Selling_Evaluator_Result__c, &apos;Decline&apos;),ISPICKVAL(cx_ln_Cross_Selling_Evaluator_Result__c, &apos;Cancelled&apos;) ),
    OR (ISPICKVAL(cx_ln_Cross_Selling_Verifier_Result__c, &apos;Decline&apos;),ISPICKVAL(cx_ln_Cross_Selling_Verifier_Result__c, &apos;Cancelled&apos;) ),  
    OR (ISPICKVAL(cx_ln_Cross_Selling_Approver_Result__c, &apos;Decline&apos;),ISPICKVAL(cx_ln_Cross_Selling_Approver_Result__c, &apos;Cancelled&apos;) )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>CrossSelling Results declined/cancelled</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
