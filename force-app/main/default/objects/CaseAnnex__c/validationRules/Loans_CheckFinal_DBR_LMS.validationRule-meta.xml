<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Loans_CheckFinal_DBR_LMS</fullName>
    <active>true</active>
    <description>RCD highlighted to have the same DBR validation that we have in loan applications, in the following manual service requests: Loan/ Finance restructure, Loan/ Finance Partial Settlement, Loan/ Finance Top-up</description>
    <errorConditionFormula>AND(
    Case__r.RecordType_DeveloperName__c == &apos;LoanFinanceServiceRequest&apos;,
    OR(ISPICKVAL(Case__r.Sub_Type__c, &apos;Restructuring&apos;),ISPICKVAL(Case__r.Sub_Type__c, &apos;Partial Settlement&apos;),ISPICKVAL(Case__r.Sub_Type__c, &apos;Top-up&apos;)),
    OR(
    AND(ISCHANGED(cx_ln_Credit_Pre_Screening_Result__c),ISPICKVAL(cx_ln_Credit_Pre_Screening_Result__c, &apos;Accept&apos;)),
    AND(ISCHANGED(cx_ln_Credit_Approval_Result__c),ISPICKVAL(cx_ln_Credit_Approval_Result__c, &apos;Approve&apos;))
    ),
    cx_ln_SR_Final_DBR__c &gt; 100
)</errorConditionFormula>
    <errorMessage>Final DBR cannot be greater than 100, Please check the Financial Details tab.</errorMessage>
</ValidationRule>
