<aura:component controller="PrizeoutController" implements="force:hasRecordId,force:lightningQuickActionWithoutHeader" >
    
    <aura:attribute name="cc_type" type="String" default="Prizeout"/> 
    <aura:attribute name="sub_type" type="String" default="Dispute"/>
    <aura:attribute name="recordTypeId" type="String" default="" />
    <aura:attribute name="Sub_Status" type="String" default="In-Progress"/>
    <aura:attribute name="RequestedBy" type="String"/>
    <aura:attribute name="cardName" type="String"/>
    <aura:attribute name="Account" type="Account" />
    <aura:attribute name="customerName" type="String"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <header class="slds-modal__header">
        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">
            <span>
                <h4 class="title slds-text-heading--medium">New Prizeout Case</h4>
            </span>
        </h2>
    </header>
    <lightning:spinner aura:id="mySpinner" alternativeText="Saving..." title="Saving.." variant="brand" size="large" class="slds-hide"/>
    
    
    <lightning:card>
        <aura:if isTrue="{! v.recordTypeId != '' }">
            <lightning:recordEditForm aura:id="form"
                                      recordTypeId="{!v.recordTypeId}"
                                      objectApiName="Case"
                                      onload="{!c.handleOnload}"
                                      onsubmit="{!c.handleOnSubmit}"
                                      onsuccess="{!c.handleOnSuccess}"
                                      onerror="{!c.handleOnError}"
                                      >
                <lightning:messages/> 
                <!--on load handle name on Card, handle Submit --> 
                <!-- <lightning:inputField fieldName="Origin" aura:id="origin" required="true" value=""/> -->
                <lightning:inputField fieldName="Subject" aura:id="subject" value="" required="true"/>
                <lightning:inputField fieldName="Description" aura:id="description" value=""/>
                <!-- <lightning:inputField fieldName="Case_Nature__c" aura:id="Case_Nature__c" value="RC"/> -->
                <lightning:inputField fieldName="Type" value="{!v.cc_type}" aura:id="type" required="true"/>
                <lightning:inputField fieldName="Sub_Type__c" value="{!v.sub_type}" aura:id="sub_type" required="true"/>
                
                <!--   <lightning:inputField fieldName="ac_RequestedBy__c" value="{!v.RequestedBy}" aura:id="RequestedBy" required="true"/> -->
                
                <aura:if isTrue="{!v.sub_type=='Dispute'}">
                    <lightning:inputField fieldName="Prizeout_Reason__c" aura:id="Prizeout_Reason" value=""/>
                    <lightning:inputField fieldName="Merchant_Name__c" aura:id="Mername" required="true"/>
                    <lightning:inputField fieldName="Transaction_Date__c" aura:id="TransDate" required="true"/>
                    <lightning:inputField fieldName="cc_Transaction_Reference_Number__c" aura:id="TransRefNo" required="true"/>
                </aura:if>
                <aura:if isTrue="{!v.sub_type=='Technical Resolution'}">
                    <lightning:inputField fieldName="Prizeout_Reason__c" aura:id="Prizeout_Reason" value=""/>
                    <lightning:inputField fieldName="Extra_information__c" aura:id="ExtrInfo" required="true"/>
                </aura:if> 
                <aura:if isTrue="{!v.sub_type=='Revoke Consent'}">
                    <lightning:inputField fieldName="Extra_information__c" aura:id="ExtrInfo" required="false"/>
                </aura:if> 
                <!--#CH1#Start-->
                <aura:if isTrue="{!v.sub_type=='Manual Review'}">
                    <lightning:inputField fieldName="Extra_information__c" aura:id="ExtrInfo" required="true"/>
                </aura:if> 
                <!--#CH1#END-->               
                <div class="slds-hide">
                    <lightning:inputField fieldName="AccountId" value="{!v.recordId}" aura:id="accId"/>
                    <lightning:inputField fieldName="status" value="New" aura:id="statusId"/>
                    <lightning:inputField fieldName="Sub_Status__c" value="In-Progress" aura:id="substatus"/>
                </div>
                
                
                <footer>
                    <div class="slds-float_right">
                        <lightning:button variant="brand" label="Save" type="submit" />
                        <lightning:button variant="brand" label="Cancel" onclick="{!c.onCancel}" />
                    </div>
                </footer>
            </lightning:recordEditForm>
        </aura:if>
    </lightning:card>
    <c:apexService aura:id="apexService"/>
</aura:component>