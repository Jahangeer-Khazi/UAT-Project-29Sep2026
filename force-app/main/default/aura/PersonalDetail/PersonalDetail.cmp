                    <lightning:input class="slds-size_1-of-1" type="text" required="{!v.isOnbording}" value="{!v.account.PersonMailingStreet}" disabled="{!v.readOnlyFields.PersonMailingStreet}" label="Mailing Street" variant="label-inline" aura:id="mailingStreet"/>
                    <!-- <lightning:inputField class="slds-size_1-of-1" fieldName="PersonMailingStreet" required="{!v.isOnbording}" value="{!v.account.PersonMailingStreet}" disabled="{!v.readOnlyFields.personmailingstreet}" variant="label-inline" aura:id="mailingStreet"/> -->
