                <!--End of changes-->
                <lightning:inputField class="slds-size_1-of-1" fieldName="Residency__pc" required="{!v.isOnbording}" value="{!v.account.Residency__pc}" disabled="{!v.readOnlyFields.residency__pc}" variant="label-inline"/>
                <!-- IBJCRM-92 Mandatory fields for Jordan -->
                <aura:if isTrue="{!v.account.Region_Flag__c=='Jordan'}">
                    <lightning:inputField fieldName="Marital_Status__pc" value="{!v.account.Marital_Status__pc}" disabled="{!v.readOnlyFields.Marital_Status__pc}" variant="label-inline" required="false"/> <!-- CH01 -->	
                    <lightning:inputField fieldName="Place_of_Birth__pc" value="{!v.account.Place_of_Birth__pc}" disabled="{!v.readOnlyFields.Place_of_Birth__pc}" variant="label-inline" required="true"/>	
                    <lightning:inputField fieldName="Place_of_birth_government__pc" value="{!v.account.Place_of_birth_government__pc}" disabled="{!v.readOnlyFields.Place_of_birth_government__pc}" variant="label-inline" required="true"/>
                </aura:if>
                
                <aura:if isTrue="{!v.account.Region_Flag__c!='Jordan'}">
                    <lightning:inputField class="slds-size_1-of-1" 
                                          fieldName="Guardian__pc" 
                                          onchange="{!c.onGuardianChange}"
                                          value="{!v.account.Guardian__pc}" 
                                          disabled="{!v.readOnlyFields.Guardian__pc}" 
                                          variant="label-inline"/>
                    
                    <aura:if isTrue="{!and(v.selectedGuardianCIF != null, v.selectedGuardianCIF != '')}">
                        <div class="slds-form-element slds-m-top_medium">
                            <label class="slds-form-element__label">Guardian CIF:</label>
                            <div class="slds-form-element__control">
                                <span aura:id="guardianCIF" class="slds-form-element__static">{!v.selectedGuardianCIF}</span>
                            </div>
                        </div>
                    </aura:if>
                    
                    <aura:if isTrue="{!and(v.errorMessage != null, v.errorMessage != '')}">
                        <div class="slds-form-element slds-m-top_medium">
                            {!v.errorMessage}
                        </div>
                    </aura:if>
                    
                </aura:if>
                
            </div></lightning:recordEditForm>
        
        <aura:set attribute="else">
            <div class="slds-p-bottom_large slds-p-left_large">
                <lightning:recordViewForm
                                          recordId="{!v.account.Id}"
                                          objectApiName="Account">
                    <div class="slds-box">
                        <lightning:outputField fieldName="Name" />
                        <lightning:outputField fieldName="Arabic_Name__pc" />
                        <lightning:outputField fieldName="PersonBirthdate" />
                        <lightning:outputField fieldName="Gender__pc" />
                        <lightning:outputField fieldName="Nationality__pc" />
                        <lightning:outputField fieldName="PersonMailingAddress" />
                        <lightning:outputField fieldName="Residency__pc" />
                        <!-- IBJCRM-92 Mandatory fields for Jordan -->
                        <aura:if isTrue="{!v.account.Region_Flag__c=='Jordan'}">
                            <lightning:outputField fieldName="Marital_Status__pc" />	
                            <lightning:outputField fieldName="Place_of_Birth__pc" />	
                            <lightning:outputField fieldName="Place_of_birth_government__pc" />
                        </aura:if>
                    </div>
                </lightning:recordViewForm>
            </div>
        </aura:set>
    </aura:if>
</aura:component>