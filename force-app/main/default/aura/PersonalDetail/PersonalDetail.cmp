                    <lightning:inputField class="slds-size_1-of-1" fieldName="Mailing_Apartment_Number__c" required="{!v.isOnbording}" value="{!v.account.Mailing_Apartment_Number__c}" disabled="{!v.readOnlyFields.Mailing_Apartment_Number__c}" variant="label-inline" aura:id="mailingApartmentNumber"/>
                    
