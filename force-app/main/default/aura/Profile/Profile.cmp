<aura:component controller="UserProfileController" access="global" >
    <aura:attribute name="customerId" type="String"/>
    <aura:attribute name="caseId" type="String"/>
    <aura:attribute name="account" type="Account" />
    <aura:attribute name="accountOld" type="Account" />
    <aura:attribute name="caseRecordType" type="String" access="public" default=""/>
    <aura:attribute name="readOnlyFields" type="Map" access="private" default="{}"/>
    <!-- ======================================================= -->
    <aura:attribute name="tabsConfig" type="Object" access="private"/> 
    <aura:attribute name="enableActions" type="Boolean" access="public" default="false"/>
    <aura:attribute name="mode" type="string" default="view"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <!-- CH01: Start -->
    <lightning:notificationsLibrary aura:id="idValNotice"/>
    <!-- CH01: END -->
  
    <lightning:card iconName="standard:account" title="{!'Details of: ' + v.account.Name}">
        <aura:set attribute="actions">
            <aura:if isTrue="{!and(v.enableActions, v.mode != 'edit')}">
                <lightning:button label="Edit" onclick="{!c.onEditClick}"/>
            </aura:if>
            <aura:if isTrue="{!and(v.enableActions, v.mode == 'edit')}">
                <lightning:button label="Save" onclick="{!c.onSaveClick}"/>
                <lightning:button label="Cancel" onclick="{!c.onCancelClick}"/>
            </aura:if>
        </aura:set>

        <lightning:tabset variant="scoped"> <!-- selectedTabId="one" -->
            
            <!--<lightning:tab label="Personal Details">
                <c:PersonalDetail aura:id="personalDetail" 
                                  customerId="{!v.customerId}" 
                                  caseId="{!v.recordId}"
                                  account="{!v.account}" 
                                  readOnlyFields="{!v.readOnlyFields}"
                                  mode="{!v.mode}"/>
            </lightning:tab>-->
            
            <lightning:tab label="Contact Information" >
                <c:ContactInformation aura:id="contactInformation" 
                                   customerId="{!v.customerId}" 
                                      caseId="{!v.recordId}" 
                                   account="{!v.account}" 
                                      readOnlyFields="{!v.readOnlyFields}"
                                      mode="{!v.mode}"/>
            </lightning:tab>
            
            <!--<lightning:tab label="ID Information">
                <c:IdInformation aura:id="idInformation" 
                                 customerId="{!v.customerId}" 
                                 caseId="{!v.recordId}"
                                 account="{!v.account}" 
                                 readOnlyFields="{!v.readOnlyFields}"
                                 mode="{!v.mode}"/>
            </lightning:tab>-->
            
            <!--<lightning:tab label="Additional Information">
                <c:AdditionalInformation aura:id="additionalInformation" 
                                         customerId="{!v.customerId}" 
                                         caseId="{!v.recordId}"
                                         account="{!v.account}" 
                                         readOnlyFields="{!v.readOnlyFields}"
                                         mode="{!v.mode}"/>
            </lightning:tab>-->
        </lightning:tabset>	
    </lightning:card>
    <c:apexService aura:id="apexService"/>
</aura:component>