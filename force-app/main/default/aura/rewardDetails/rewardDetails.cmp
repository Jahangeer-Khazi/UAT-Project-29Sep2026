                               {!v.rewardDetail.nextCashbackDate}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
             </div>
        </aura:if>
        <aura:if isTrue="{!(v.preferredRewardsOption=='AIRLINE_MILES')}">
