<aura:component controller="Loans_RLOSViewController" 
                implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:hasSObjectName" 
                access="global">
    
    <aura:html tag="style">
            .slds-modal__container {
                width : 800px !important;
                max-width : 800px !important;
            }
            <!-- Define a new CSS class for the two-column layout -->
            .two-column-layout {
                display: flex;
                justify-content: space-between;
            }

            .column {
                width: 48%; /* Adjust the width as needed */
            }

            .accordionClass{
                --slds-c-accordion-heading-font-size:1rem;
                --slds-c-accordion-summary-color-background:#f3f2f2;
                --slds-c-accordion-summary-radius-radius:# 5px;
            }

            .sub-section {
            
            }
            
            .sub-section h4 {
                font-size: 14px;
                padding: 3px;
                color: #333;
                background-color: #dfeeff;
                width: 100%;
                box-sizing: border-box;
                margin-top: 10px;
                margin-left: 10px;
            }
            
            
    </aura:html>

    <!-- Attributes -->
    <aura:attribute name="activeSections" type="List" default="['ToBeProvidedByCustomerSection','PrescreenerSection','EvaluatorSection','VerifierSection', 'ApproverSection', 'BusinessTeamSection', 'CEOSection', 'OperationSection', 'SignatureVerificationSection', 'DocumentVerifierSection', 'DocumentVerifierOBLSection']" />
    <aura:attribute name="pendingLoan" type="Object" />
    <aura:attribute name="pendingLoanstatus" type="String" />

    <!-- Add an init handler to execute a function on component load -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <!-- Start -->
    <div class="slds-hidden" style="height: 0px;">
        <lightning:recordEditForm recordId="{!v.recordId}" objectApiName="Case" onload="{!c.handleLoad}">
            <lightning:inputField aura:id="LoanApplicationId" fieldName="Loan_Application_ID__c" />
        </lightning:recordEditForm>
    </div>
    <!-- End-->
    <aura:if isTrue="{!not(v.pendingLoan)}">
        <br/>
        <br/>
        <div  aura:id="NoDataDivElement" class="slds-hidden" style="text-align: center;">
            <span style="color: red; font-weight: bold; font-size: 20px;">There is No Pending Loan Application or the Loan Application ID on the case detail is missing.. !!</span>
        </div>
        <br/>

        <aura:set attribute="else">
            <br/>
            <lightning:progressIndicator currentStep="{!v.pendingLoanstatus}" type="path" variant="shade">
                <lightning:progressStep label="Pending" value="Pending"/>
                <lightning:progressStep label="Discrepancies" value="Discrepancies"/>
                <lightning:progressStep label="Review" value="Review"/>
                <lightning:progressStep label="Referred" value="Referred"/>
                <lightning:progressStep label="Closed" value="Closed"/>
            </lightning:progressIndicator>
            <br/>
            <br/>

            <lightning:card title="{!'Details of Loan Application :'+ v.pendingLoan.applicationId}">
            <lightning:accordion 
                    allowMultipleSectionsOpen="true" 
                    activeSectionName="{! v.activeSections }" 
                    class="accordionClass">
                <br/>

                <!-- TO be provided by Customer (App) or Contact Center Section -->
                <!-- <lightning:accordionSection name="ToBeProvidedByCustomerSection" label="To be provided by Customer (App) or Contact Center" aura:id="ToBeProvidedByCustomerSection" class="sectionStyle">
    
                    Use the two-column layout class
                    <div class="two-column-layout">

                        First column
                        <div class="column">
                            
                            Line 
                            <div class="slds-form__item" role="listitem">
                                <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                                    <span class="slds-form-element__label">Unit</span>
                                    <div class="slds-form-element__control">
                                        <div class="slds-form-element__static">
                                            {!v.pendingLoan.infinityPreScreener.cprNumber}
                                        </div>
                                    </div>
                                </div>
                            </div>    

                            Line 
                            <div class="slds-form__item" role="listitem">
                                <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                                    <span class="slds-form-element__label">Product</span>
                                    <div class="slds-form-element__control">
                                        <div class="slds-form-element__static">
                                            {!v.pendingLoan.infinityPreScreener.cprExpiryDate}
                                        </div>
                                    </div>
                                </div>
                            </div>  

                            Line 
                            <div class="slds-form__item" role="listitem">
                                <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                                    <span class="slds-form-element__label">Employment Status</span>
                                    <div class="slds-form-element__control">
                                        <div class="slds-form-element__static">
                                            {!v.pendingLoan.infinityPreScreener.passportNumber}
                                        </div>
                                    </div>
                                </div>
                            </div>  

                            Line 
                            <div class="slds-form__item" role="listitem">
                                <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                                    <span class="slds-form-element__label">Employer Name</span>
                                    <div class="slds-form-element__control">
                                        <div class="slds-form-element__static">
                                            {!v.pendingLoan.infinityPreScreener.passportExpiryDate}
                                        </div>
                                    </div>
                                </div>
                            </div>  

                            Line 
                            <div class="slds-form__item" role="listitem">
                                <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                                    <span class="slds-form-element__label">Whitelisted Employer</span>
                                    <div class="slds-form-element__control">
                                        <div class="slds-form-element__static">
