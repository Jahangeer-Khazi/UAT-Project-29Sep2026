                        <div class="slds-form-element__control">
                            <div class="slds-form-element__static">
                                {!(v.cardData.memoCredit==0?v.cardData.memoCredit:'-'+v.cardData.memoCredit)}
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </lightning:card>
    <lightning:card title="Last Statement Details">
        <div class="slds-form" role="list" style="padding: 1rem;">
            <div class="slds-form__row">

                <div class="slds-form__item" role="listitem">
                    <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                        <span class="slds-form-element__label">Last Statement Balance</span>
                        <div class="slds-form-element__control">
                            <div class="slds-form-element__static">
                                <!-- CH12 start  -->
                                <aura:if isTrue="{!v.hideJordanFinancialDetails == false}">

                                    {!v.cardData.paymentLastStatementBalanceNew}
                                </aura:if>
                                <!-- CH12 end  -->
                            </div>

                        </div>
                    </div>
                </div>

                <div class="slds-form__item" role="listitem">
                    <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                        <span class="slds-form-element__label">Original Statement Balance</span>
                        <div class="slds-form-element__control">
                            <div class="slds-form-element__static">
                                {!v.cardData.lastStatmentBalance }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="slds-form__row">
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                        <span class="slds-form-element__label">Remaining EPP Installments</span>
                        <div class="slds-form-element__control">
                            <div class="slds-form-element__static">
                                {!(v.cardData.futureEPP==0?v.cardData.futureEPP:'-'+v.cardData.futureEPP)}

                            </div>

                        </div>
                    </div>
                </div>
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                        <span class="slds-form-element__label">Recent Payments</span>
                        <div class="slds-form-element__control">
                            <div class="slds-form-element__static">
                                {!(v.cardData.lastStatementRecentPayments==0?v.cardData.lastStatementRecentPayments:'-'+v.cardData.lastStatementRecentPayments)}
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </lightning:card>
    <lightning:card title="Outstanding Details">
        <div class="slds-form" role="list" style="padding: 1rem;">
            <div class="slds-form__row">
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                        <span class="slds-form-element__label">Outstanding Balance</span>
                        <div class="slds-form-element__control">
                            <div class="slds-form-element__static">

                                {!v.cardData.paymentOutstandingBalance}

                            </div>

                        </div>
                    </div>
                </div>
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                        <span class="slds-form-element__label">Full Outstanding</span>
                        <div class="slds-form-element__control">
                            <div class="slds-form-element__static">
                                {!v.cardData.usedCreditLimit}
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="slds-form__row">
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                        <span class="slds-form-element__label">Remaining EPP Installments</span>
                        <div class="slds-form-element__control">
                            <div class="slds-form-element__static">
                                {!(v.cardData.futureEPP==0?v.cardData.futureEPP:'-'+v.cardData.futureEPP)}

                            </div>

                        </div>
                    </div>
                </div>
                <div class="slds-form__item" role="listitem">
                </div>

            </div>
        </div>
    </lightning:card>
    <!-- CH11 START -->
    <lightning:card title="Annual Membership Details">
        <div class="slds-form" role="list" style="padding: 1rem;">
            <div class="slds-form__row">
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form__item" role="listitem">
                        <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                            <span class="slds-form-element__label">Next Membership Renewal Date</span>
                            <div class="slds-form-element__control">
                                <div class="slds-form-element__static">
                                    {!v.cardData.nextMembershipRenewalDate}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form__item" role="listitem">
                        <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                            <span class="slds-form-element__label">Next Membership Renewal Fee</span>
                            <div class="slds-form-element__control">
                                <div class="slds-form-element__static">
                                    {!v.cardData.nextMembershipRenewalFee}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="slds-form__row">
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form__item" role="listitem">
                        <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                            <span class="slds-form-element__label">Next Membership Renewal Fee VAT</span>
                            <div class="slds-form-element__control">
                                <div class="slds-form-element__static">
                                    {!v.cardData.nextMembershipRenewalFeeVAT}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form__item" role="listitem">
                        <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                            <span class="slds-form-element__label">Next Membership Renewal Waiver Flag</span>
                            <div class="slds-form-element__control">
                                <div class="slds-form-element__static">
                                    {!v.cardData.nextMembershipRenewalWaiverFlag}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="slds-form__row">
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form__item" role="listitem">
                        <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                            <span class="slds-form-element__label">Next Membership Renewal Waiver Limit</span>
                            <div class="slds-form-element__control">
                                <div class="slds-form-element__static">
                                    {!v.cardData.nextMembershipRenewalWaiverLimit}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form__item" role="listitem">
                        <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                            <span class="slds-form-element__label">Total Spending Since Last Renewal</span>
                            <div class="slds-form-element__control">
                                <div class="slds-form-element__static">
                                    {!v.cardData.totalSpendSinceLastRenewal}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="slds-form__row">
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form__item" role="listitem">
                        <div class="slds-form-element slds-form-element_readonly slds-form-element_horizontal">
                            <span class="slds-form-element__label">Remaining Spend For Waiver</span>
                            <div class="slds-form-element__control">
                                <div class="slds-form-element__static">
                                    {!v.cardData.remainingSpendForWaiver}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="slds-form__item" role="listitem">
                    <div class="slds-form__item" role="listitem">&nbsp;</div>
                </div>
            </div>
        </div>
    </lightning:card>
    <!-- CH11 END -->
    <!-- CH04 START Added a AND Condition in aura:if v.caseSubType != 'Credit Limit Decrease'-->
    <!-- CH07:  added if condition to control the visibility when casesubtype is 'Generate Cash Collateral Letter'-->
    <aura:if
        isTrue="{!and(true == v.enableActions, and(v.caseSubType != 'Credit Limit Decrease',v.caseSubType != 'Generate Cash Collateral Letter'))}">
        <!-- #CH02 : Add targetType Variable -->
        <c:creditCardAction customerId="{!v.customerId}" cardDetails="{!v.cardData}" account="{!v.account}"
            caseId="{!v.caseId}" accountId="{!v.accountId}" targetType="{!v.targetType}" />
    </aura:if>
    <!-- CH04 END -->


    <c:apexService aura:id="apexService" />
</aura:component>