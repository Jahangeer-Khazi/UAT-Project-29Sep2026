<aura:component controller = "DailyPaymentHistoryController">
	 <aura:attribute name="customerId" type="String" required="true"/>
     <aura:attribute name="account" type="Account" required="true"/>
     <aura:attribute name="caseId" type="String" required="false"/>
     <aura:attribute name="enableActions" type="Boolean" required="true"/>
     <aura:attribute name="caseRecordType" type="String"/>
     <aura:attribute name="sObjectName" type="String"/>
    
    <!-- Datatable data -->
    <aura:attribute name="dailyLimitData" type="Object[]"/>
    
    <!-- Datatable columns -->
    <aura:attribute name="columns" type="List"/>
    
     <!-- Spinner -->
    <aura:attribute name="isLoading" type="Boolean" default="false"/>
    
    <aura:handler name="init" value="{! this }" action="{!c.init }"/>
    <aura:attribute name="errorMessage" type="String" default=""/>
    
    <lightning:card title="Daily Payment Limit">

        <div class="slds-p-around_medium">
            <!-- Spinner -->
            <aura:if isTrue="{!v.isLoading}">
				<lightning:spinner alternativeText="Loading Daily Payment Limit..." size="medium"/>
			</aura:if>
            
            <!-- Error Banner -->
            <aura:if isTrue="{!not(empty(v.errorMessage))}">
                <div class="slds-notify slds-notify_alert slds-alert_error slds-m-bottom_small" role="alert">
                    <h2>{!v.errorMessage}</h2>
                </div>
            </aura:if>

            <lightning:datatable
                	   	keyField="id"
                		data="{!v.dailyLimitData}"
                		columns="{!v.columns}"
                		hideCheckboxColumn="true"
                		showRowNumberColumn="false"/>
			</div>
	</lightning:card>
    <!--<lightning:spinner aura:id="mySpinner" alternativeText="Saving..." title="Saving.." variant="brand" size="large" class="slds-hide"/>
    <c:apexService aura:id="apexService"/> -->
</aura:component>