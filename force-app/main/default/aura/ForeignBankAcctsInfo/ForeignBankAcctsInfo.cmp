<aura:component controller="DeviceDetailsController" implements="lightning:availableForFlowScreens" access="global">
    <aura:attribute name="customerId" type="String"/>
    <aura:attribute name="cifNumber" type="String" access="global"/>
    <aura:attribute name="fColumns" type="List"/>
    <aura:attribute name="bankAccts" type="List"/>
    <aura:attribute name="isLoadingaccts" type="Boolean" default="false"/>
    <aura:attribute name="message" type="String" default = ""/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <aura:if isTrue="{!v.isLoadingaccts}">
        <lightning:spinner size="medium"/>
    </aura:if>
    <aura:if isTrue="{!empty(v.bankAccts)}">
        <div class="slds-text-color_error slds-text-title_bold">
        	{!v.message}
        </div>
        
        <aura:set attribute="else">
            <lightning:datatable
                                 keyField="id"
                                 data="{!v.bankAccts}"
                                 columns="{!v.fColumns}"
                                 hideCheckboxColumn="true"/>
        </aura:set>
    </aura:if>
    <br/>
	
</aura:component>