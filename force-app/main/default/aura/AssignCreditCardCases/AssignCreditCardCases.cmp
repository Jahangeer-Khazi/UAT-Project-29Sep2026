<aura:component controller="creditCardCaseController" implements="force:appHostable,lightning:isUrlAddressable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global">
    <aura:attribute name="mydata" type="Object"/>
    <aura:attribute name="mycolumns" type="List"/>
    <aura:attribute name="salesagent" type="String"/>
    <aura:attribute name="RequestType" type="String" default='None'/>
    <aura:attribute name="CCApplication" type="List"/>
    <aura:handler name="init" value="{! this }" action="{! c.init }"/>
    <aura:attribute name="isModalOpen" type="boolean" default="true"/>
    <aura:attribute name="isAssignTo" type="boolean" default="false"/>
    <aura:attribute name="allData" type="List" />
    <aura:attribute name="filteredData" type="List" />
    <aura:attribute name="tableData" type="List" />
    <aura:attribute name="columns" type="Object[]" />
    <aura:attribute name="pageSize" type="Integer" default="15" />
    <aura:attribute name="pageSizeOptions" type="Integer[]" default="10,15,20,25,50,100" />
    <aura:attribute name="currentPageNumber" type="Integer" default="1" />
    <aura:attribute name="totalPages" type="Integer" default="1" />
    <aura:attribute name="searchPhrase" type="String" />
    <aura:attribute name="isLoading" type="Boolean" default="false" />
    <aura:attribute name="pending" type="Boolean" default="false"/>
    <aura:attribute name="RequestTypeList" type="String[]" default="['None','Credit Card Application','Credit Card Supplementary Application','Credit Card Cash Collateral Application','Credit Card Prepaid Application']"/> 
    <lightning:overlayLibrary aura:id="overlayLib"/>
    <div class="slds-m-around_xx-large">
        <!--Use aura:if tag to display/hide popup based on isModalOpen value-->  
        <aura:if isTrue="{!v.isModalOpen}">
            
            <!-- Modal/Popup Box starts here-->
            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container">
                    <!-- Modal/Popup Box Header Starts here-->
                    <header class="slds-modal__header">
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{! c.closeModel }"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">Credit Card Applications</h2>
                    </header>
                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                        <div class="slds-p-around--large">
                            
                            <div class="slds-page-header" style="cursor: pointer;" onclick="{!c.sectionOne}">
                                <section class="slds-clearfix">
                                    <div class="slds-float--left ">
                                        <lightning:icon class="slds-show" aura:id="articleOne" iconName="utility:add" size="x-small" alternativeText="Indicates add"/>
                                        <lightning:icon class="slds-hide" aura:id="articleOne" iconName="utility:dash" size="x-small" alternativeText="Indicates dash"/>
                                    </div>
                                    <div class="slds-m-left--large">Search Criteria</div>
                                </section>
                            </div>
                            
                            <div  aura:id="articleOne">
                                <aura:if isTrue="{! v.isLoading }">
                                    <lightning:spinner alternativeText="Loading" />
                                </aura:if>
                                <lightning:card>
                                    <lightning:layout>
                                        <lightning:layoutItem size="8" padding="around-small">
                                            <!--<div class="slds-p-around_small slds-grid slds-grid_align-spread slds-grid_horizontal-align-start">-->
                                            <div>
                                                
                                                <!-- <div class="slds-modal__content slds-m-around_large" id="modal-content-id-1">-->
                                                
                                                <lightning:recordEditForm aura:id="recordEditForm" objectApiName="Case">
                                                    <div class="inline-container">
                                                        <fieldset class="slds-form--compound">
                                                            <div class="form-element__group">
                                                                <div class="slds-form-element__row">
                                                                    <div class="slds-form-element slds-size--1-of-2">
                                                                        <span class="padding-right">
                                                                            <lightning:inputField fieldName="Sales_Agent__c" value="{!v.salesagent}"/>
                                                                        </span>
                                                                    </div>
                                                                    <div class="slds-form-element slds-size--1-of-2">                                           
                                                                        <lightning:button variant="brand"
                                                                                          label="Assign Sales Agent"
                                                                                          title="Assign Sales Agent"
                                                                                          onclick="{!c.assignSalesAgent}" class="sales"/>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </fieldset>
                                                    </div>
                                                    <lightning:messages />
                                                </lightning:recordEditForm>
                                            </div>
                                        </lightning:layoutItem>
                                    </lightning:layout>
                                    <lightning:layout>
                                        <lightning:layoutItem>
                                            <div class="inline-container">
                                                <fieldset class="slds-form--compound">
                                                    <div class="form-element__group">
                                                        <div class="slds-form-element__row">
                                                            <div class="slds-form-element slds-size--1-of-2 searchleft">
                                                                <lightning:select aura:id="typePicklist" name="select" label="Request Type" onchange="{!c.selectedType}">
                                                                    <aura:iteration items="{!v.RequestTypeList}" var="item">
                                                                        <option>{!item}</option>
                                                                    </aura:iteration>
                                                                </lightning:select>
                                                            </div>
                                                            <div class="slds-form-element slds-size--1-of-2 searchholder">
                                                                <lightning:input
                                                                                 variant="label-hidden"
                                                                                 placeholder="Name\CIF"
                                                                                 type="search"
                                                                                 value="{! v.searchPhrase }"
                                                                                 onchange="{! c.onChangeSearchPhrase }" />
                                                                
                          
                                                            </div>
                                                           
															<!--<ui:inputCheckbox aura:id="checkbox" label="Pending>20 Days" change="{!c.onCheck}"/>-->
                                                        
                                                            <div class="slds-form-element slds-size--1-of-2 searchholder">
                                                                <lightning:button
                                                                                  label="Search"
                                                                                  variant="neutral"
                                                                                  onclick="{! c.handleSearch }" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                            
                                            <!-- </div>-->
                                        </lightning:layoutItem>
                                    </lightning:layout>
                                </lightning:card>
                                <lightning:card>
                                    <div class="slds-p-around_small slds-grid slds-grid_align-spread slds-grid_vertical-align-start">
                                        <div>
                                            <lightning:select
                                                              label="Number of records on page:"
                                                              value="{! v.pageSize }"
                                                              onchange="{! c.onPageSizeChange }">
                                                <aura:iteration items="{! v.pageSizeOptions }" var="opt">
                                                    <option text="{! opt }"></option>
                                                </aura:iteration>
                                            </lightning:select>
                                        </div>
                                        <div>
                                            <lightning:button
                                                              label="First"
                                                              iconName="utility:left"
                                                              iconPosition="left"
                                                              onclick="{! c.onFirst }"
                                                              disabled="{! v.currentPageNumber == 1 }" />
                                            <lightning:button
                                                              label="Previous"
                                                              iconName="utility:chevronleft"
                                                              iconPosition="left"
                                                              onclick="{! c.onPrev }"
                                                              disabled="{! v.currentPageNumber == 1 }" />
                                            <span class="slds-var-p-horizontal_x-small">
                                                Page {! (v.currentPageNumber) } of {! (v.totalPages) }
                                            </span>
                                            <span class="slds-var-p-horizontal_x-small">
                                                Number of records: {! (v.filteredData.length) }
                                            </span>
                                            <lightning:button
                                                              label="Next"
                                                              iconName="utility:chevronright"
                                                              iconPosition="right"
                                                              onclick="{! c.onNext }"
                                                              disabled="{! v.currentPageNumber == v.totalPages }" />
                                            <lightning:button
                                                              label="Last"
                                                              iconName="utility:right"
                                                              iconPosition="right"
                                                              onclick="{! c.onLast }"        
                                                              disabled="{! v.currentPageNumber == v.totalPages }" />
                                        </div>
                                    </div>
                                    <lightning:datatable
                                                         aura:id="caseTable"
                                                         columns="{! v.columns }"
                                                         data="{! v.tableData  }"
                                                         keyField="Id" />
                                </lightning:card>
                                <!-- <lightning:datatable data="{! v.mydata }" 
                                             columns="{! v.mycolumns }" keyField="id" aura:id="caseTable"/>-->
                            </div>
                        </div>
                    </div>
                    <footer class="slds-modal__footer">
                        <lightning:button variant="neutral"
                                          label="Close"
                                          title="Close"
                                          onclick="{! c.closeModel }"/>
                        <!--<lightning:button variant="brand"
                                          label="Select"
                                          title="Select"
                                          onclick="{!c.getSelectedId}"/>-->
                    </footer>
                </div>
            </section>
            <div class="slds-backdrop slds-backdrop_open"></div>
        </aura:if>
    </div>
    <!-- onrowselection="{! c.getSelectedId }"/>-->
    
</aura:component>