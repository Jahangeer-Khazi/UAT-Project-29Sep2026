<aura:component implements="force:hasRecordId,force:lightningQuickActionWithoutHeader"  access="global" controller="LTNG050_DisputeAgingKPIController">

<aura:attribute name="subtypeOptions" type="List" />
<aura:attribute name="SubTypeSelected" type="String" />
<aura:attribute name="commentValue" type="String"/>
<aura:handler name="init" value="{!this}" action="{!c.doInit}" />
<aura:attribute name="recordId" type="String" />
<aura:attribute name="record" type="Object" />
<aura:attribute name="error" type="String" />
<aura:attribute name="showSpinner" type="Boolean" default="false"  />



<force:recordData layoutType="FULL"
                  recordId="{!v.recordId}"
                  targetFields="{!v.record}"
                  recordUpdated="{!c.recordUpdate}" />

                      
<section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open slds-modal_large">
<div class="slds-modal__container">
    <!--Modal Header-->
    <header class="slds-modal__header">

        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">
            <span>
                <h4 class="title slds-text-heading--medium">SLA Tracker</h4>
            </span>
        </h2>
    </header>
    <!--End Modal Header-->

    <!--Modal Body-->

    <div class="slds-modal__content slds-p-around_medium slds-p-top_x-small" id="modal-content-id-1">
            <lightning:select label="Type" value="{!v.SubTypeSelected}">
                <aura:iteration items="{!v.subtypeOptions}" var="option">
                    <option value="{!option.value}">{!option.label}</option>
                </aura:iteration>
            </lightning:select>
            <lightning:textarea label="Comment" aura:id="comment" value="{!v.commentValue}" required="true" />

    <!--End of Modal Body-->

    <!-- MODAL FOOTER -->
    <div style="background-color: white; margin-top:50px;"  class="modal-footer slds-modal__footer slds-size_1-of-1">
        <div class="forceChangeRecordTypeFooter">

            <lightning:button label="Save" class="slds-button slds-button_neutral" variant="brand" onclick="{!c.saveRecord}"/>

            <lightning:button aura:id="Footer-id" label="Cancel" class="slds-button slds-button_neutral"
                onclick="{!c.close}" />

        </div>
    </div>
    <aura:if isTrue="{!v.showSpinner}">
        <lightning:spinner aura:id="mySpinner" alternativeText="Saving..." title="Saving.." variant="brand" size="large"/>
    </aura:if>
   </div>
   </div>
</section>
</aura:component>