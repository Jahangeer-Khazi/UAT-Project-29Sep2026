<aura:component  controller="LTNG062_compliantController" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:isUrlAddressable" access="global" >
	    
    <aura:attribute name="type" type="String" default="Customer Services"/> 
    <aura:attribute name="Sub_Type__c" type="String" />
    <aura:attribute name="cc_Request_Type__c" type="String" />
    <aura:attribute name="OD_Reason__c" type="String" />
    <aura:attribute name="recordTypeId" type="String" />
    <aura:attribute name="currentAcc" type="Object" />
    <aura:attribute name="showSpinner" type="Boolean" default="false"  />
    <aura:attribute name="caseModel" type="String" /><!--CH01-->
    <aura:attribute name="accountRecord" type="Object"/>
    <aura:attribute name="genrecordId" type="String" />
    <aura:attribute name="contactId" type="String" />
    <aura:attribute name="cif" type="String" />
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="account" type="Account"/>
    <aura:attribute name="Restriction_Reason" type="String" />
    <aura:attribute name="creditLimit" type="String"/>
    <aura:attribute name="creditOutstanding" type="String"/>
    <aura:attribute name="cc_cardPCINumber" type="Map"/>
    <aura:attribute name="selectedPCINumber" type="String"/>
    <aura:attribute name="interactionId" type="String"/>
    <aura:handler name="change" value="{!v.pageReference}" action="{!c.doInit}" />
    

    <aura:attribute name="caseNature" type="String" /> <!--CH02-->
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <!--<force:recordData 
    recordId="{!v.recordId}" 
    layoutType="FULL" 
    targetFields="{!v.accountRecord}" 
    mode="VIEW" 
    fields="PersonEmail,Region_Flag__pc"
    recordUpdated="{! c.handleRecord }"
    />-->
    <header class="slds-modal__header">
        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">
            <span>
                <h4 class="title slds-text-heading--medium">New Compliant</h4>
            </span>
        </h2>
        </header>
        <!--CH01 - Start-->
    <div class="slds-hidden" style="height: 0px;">
        <lightning:recordEditForm recordId="{!v.recordId}" objectApiName="Account" onload="{!c.handleLoad}">
            <lightning:inputField aura:id="Subscription_Model" fieldName="Subscription_Model__pc" />
        </lightning:recordEditForm>
    </div>
    <!--CH01 - End-->
    
    <lightning:card>
        <aura:if isTrue="{! v.recordTypeId != '' }">
            <lightning:recordEditForm aura:id="form"
                                      recordTypeId="{!v.recordTypeId}"
                                      objectApiName="Case"     
                                      onsubmit="{!c.handleOnSubmit}"
                                      onsuccess="{!c.handleOnSuccess}"
                                      onerror="{!c.handleOnError}"
                                      >
                <lightning:messages/>
                <!--on load handle name on Card, handle Submit -->
                
                <lightning:inputField fieldName="Case_Model__c" aura:id="caseModel" required="true" value="{!v.caseModel}"/>               
                <lightning:inputField fieldName="Type" aura:id="type" required="true" value="{!v.type}"/>
                <lightning:inputField fieldName="Sub_Type__c" value="{!v.Sub_Type__c}" aura:id="subType" required="true" />
                <lightning:inputField fieldName="cc_Request_Type__c" value="{!v.cc_Request_Type__c}" aura:id="reqType" required="true" />   
                <lightning:inputField fieldName="Case_Nature__c" value="{!v.caseNature}" aura:id="CaseNature" required="true" />
                <lightning:inputField fieldName="Origin" aura:id="origin" required="true"/>
                <lightning:inputField fieldName="Subject" aura:id="subject" />
                <lightning:inputField fieldName="Description" aura:id="description" />
                <label for="gensysId">Genesys InterationID</label>
                <lightning:inputField fieldName="External_Id__c" aura:id="gensysId" value="{!v.interactionId}" variant="label-hidden" readonly="true"/>
                
                <div class="slds-hide">
                    <lightning:inputField fieldName="AccountId" value="{!v.recordId}" aura:id="accId"/>
                    
                </div>
                
                <br/>
                <br/>

                <footer>
                    <div class="slds-float_right">
                        <lightning:button variant="brand" label="Cancel" onclick="{!c.onCancel}" />
                        <lightning:button variant="brand" label="Save" type="submit" disabled="{!v.showSpinner}" />
                    </div>
                </footer>

            </lightning:recordEditForm>
        </aura:if>

        <aura:if isTrue="{!v.showSpinner}">
            <lightning:spinner aura:id="mySpinner" alternativeText="Saving..." title="Saving.." variant="brand" size="large"/>
        </aura:if>
    </lightning:card>
</aura:component>