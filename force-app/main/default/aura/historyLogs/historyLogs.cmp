<aura:component controller = "DailyPaymentHistoryController">
    <aura:attribute name="customerId" type="String" required="true"/>
     <aura:attribute name="accountId" type="String" />
     <aura:attribute name="account" type="Account" required="true"/>
     <aura:attribute name="caseId" type="String" required="false"/>
     <aura:attribute name="enableActions" type="Boolean" required="true"/>
     <aura:attribute name="caseRecordType" type="String"/>
     <aura:attribute name="sObjectName" type="String"/>
    
    <aura:attribute name="allHistoryData" type="Object[]"/>
    <aura:attribute name="historyData" type="Object[]"/>
	<aura:attribute name="columns" type="List"/>
	<aura:attribute name="selectedDate" type="String"/>
    
    <aura:attribute name="isLoading" type="Boolean" default="false"/>

    <aura:attribute name="sortedBy" type="String" default="paymentTimestamp"/>
    <aura:attribute name="sortedDirection" type="String" default="asc"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    
    <lightning:card>

        <div class="slds-is-relative">

            <!-- ======================================== -->
            <!-- Spinner                                  -->
            <!-- ======================================== -->

            <aura:if isTrue="{!v.isLoading}">

                <lightning:spinner alternativeText="Loading History Logs..." size="medium"/>

            </aura:if>


            <!-- ======================================== -->
            <!-- Date Picker                              -->
            <!-- ======================================== -->

            <div class="slds-p-horizontal_medium slds-p-top_medium">
                <div class="slds-grid">
        			<div class="slds-size_1-of-2">
						<lightning:input
                    					type="date"
                    					label="Select Date"
                    					value="{!v.selectedDate}"
                    					onchange="{!c.handleDateChange}"/>
                    </div>
                </div>

            </div>


            <!-- ======================================== -->
            <!-- History Datatable                        -->
            <!-- ======================================== -->

            <aura:if isTrue="{!not(empty(v.historyData))}">

                <div class="slds-p-around_medium">

                    <lightning:datatable
                        keyField="id"
                        data="{!v.historyData}"
                        columns="{!v.columns}"
                        hideCheckboxColumn="true"
                        showRowNumberColumn="false"
                        sortedBy="{!v.sortedBy}"
                        sortedDirection="{!v.sortedDirection}"
                        onsort="{!c.handleSort}"/>

                </div>

                <!-- ======================================== -->
                <!-- No Records Message                      -->
                <!-- ======================================== -->

                <aura:set attribute="else">

                    <div class="slds-p-around_medium slds-text-align_center">

                        <p>
                            No Rejected payment history found for the selected date.
                        </p>

                    </div>

                </aura:set>

            </aura:if>

        </div>

    </lightning:card>
	
</aura:component>