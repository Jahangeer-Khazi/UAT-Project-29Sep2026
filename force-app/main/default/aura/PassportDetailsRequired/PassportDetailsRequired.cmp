<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global" >
   <aura:attribute name="flag" type="boolean" default="true"/>
   <aura:if isTrue="{!v.flag}"> 
    	<lightning:recordEditForm aura:id="recordViewForm" recordId="{!v.recordId}"
                                  onsuccess ="{!c.onSuccessAction}"
                              	  objectApiName="Case">	
			<lightning:inputField aura:id="PNumber" fieldName="cc_Passport_Number__c"  variant="label-inline" value="{!v.Case.cc_Passport_Number__c}" required="true"/>
            <lightning:inputField aura:id="PExpDate" fieldName="cc_Passport_Expiry_Date__c"  variant="label-inline" value="{!v.Case.cc_Passport_Expiry_Date__c}" required="true"/>
            <lightning:inputField aura:id="DCountry" fieldName="Document_Country__c"  variant="label-inline" value="{!v.Case.Document_Country__c}" required="true"/>
            <lightning:inputField aura:id="Nationality" fieldName="pcNationality__c"  variant="label-inline" value="{!v.Case.pcNationality__c}" required="true"/>

        <lightning:button variant="brand" type="submit" label="Save" />

 		</lightning:recordEditForm> 
    </aura:if>
</aura:component>