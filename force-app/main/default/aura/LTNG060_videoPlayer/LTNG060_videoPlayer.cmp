<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" controller='LTNG060VideoPlayerController' >
<aura:attribute name="recordId" type="Id" />
<aura:attribute name="videoUrl" type="String" />
<aura:handler name="init" value="{!this}" action="{!c.doInit}" />

<aura:if isTrue="{!not(empty(v.videoUrl))}">
    <video width="640" height="360" controls="True">
<source src="{!v.videoUrl}" type="video/mp4" />
Your browser does not support the video tag.
</video>
<aura:set attribute="else">
<p>No video found.</p>
</aura:set>
</aura:if>
</aura:component>