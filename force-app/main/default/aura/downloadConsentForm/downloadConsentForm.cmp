<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader" access="global">
 <aura:attribute name="vfpage" type="Boolean" default="false"/>  

 <lightning:button label="Download Consent Form"
                      iconName="utility:download"
                      iconPosition="left"
                      variant="brand"
                      onclick="{!c.showPopup}" />
    <aura:if isTrue="{!v.vfpage}">
    <div role="dialog" tabindex="-1" aria-labelledby="header43" aura:id="Modalbox" class="slds-modal slds-modal_large">
        <div class="slds-modal__container" style="width:50%;">
            <div class="slds-modal__header">
                <h1><p><b>Consent Form</b></p></h1>
            </div>
            <div class="slds-modal__content slds-p-around--medium">  
                <iframe src="{!($Label.c.BankStatementConsentVf+v.recordId)}" width="100%" height="500px;" frameBorder="0"/>
            </div>
            <div class="slds-modal__footer">
                <lightning:button label="close" onclick="{!c.closeModal}" />
            </div>
        </div>
    </div>
    </aura:if>
</aura:component>