<aura:component controller="LeadTriggerHandler" implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction,lightning:actionOverride" access="global" >
	<aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <div class="slds-text-heading_medium slds-text-align_center slds-text-color_success">
        The Lead hass been assigned to the Checker's Queue
    </div>
</aura:component>