<aura:component controller="LTNG021_AccountInterestRateController" implements="force:hasRecordId,force:lightningQuickActionWithoutHeader" >
    
    <aura:attribute name="type" type="String" default="Account Maintenance"/> 
    <aura:attribute name="Sub_Type__c" type="String" default="Account Interest Rate Update"/>
    <aura:attribute name="recordTypeId" type="String" default="" />
    <aura:attribute name="currentAcc" type="Object" />
    <aura:attribute name="showSpinner" type="Boolean" default="false"  />
    <aura:attribute name="caseModel" type="String" /><!--CH01-->
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <header class="slds-modal__header">
        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">
            <span>
                <h4 class="title slds-text-heading--medium">New Account Interest Rate Update/ Re-instate Request</h4>
            </span>
        </h2>
        </header>
    <!--CH01 - Start-->
    <div class="slds-hidden" style="height: 0px;">
        <lightning:recordEditForm recordId="{!v.recordId}" objectApiName="Account" onload="{!c.handleLoad}">
            <lightning:inputField aura:id="Subscription_Model" fieldName="Subscription_Model__pc" />
        </lightning:recordEditForm>
    </div>
    <!--CH01 - End-->
    <lightning:card>
        <aura:if isTrue="{! v.recordTypeId != '' }">
            <lightning:recordEditForm aura:id="form"
                                      recordTypeId="{!v.recordTypeId}"
                                      objectApiName="Case"     
                                      onload="{!c.handleOnload}"
                                      onsubmit="{!c.handleOnSubmit}"
                                      onsuccess="{!c.handleOnSuccess}"
                                      onerror="{!c.handleOnError}"
                                      >
                <lightning:messages/>
                <!--on load handle name on Card, handle Submit -->
                <lightning:inputField fieldName="Subject" aura:id="subject" />
                <lightning:inputField fieldName="Description" aura:id="description" />
                <!--CH01 Start Added by D&A technologies team 22-06-2022 add case model field -->
                <lightning:inputField fieldName="Case_Model__c" aura:id="caseModel" required="true" value="{!v.caseModel}"/>
                <!--CH01 END -->
                <lightning:inputField fieldName="Origin" aura:id="origin" required="true"/>
                <lightning:inputField fieldName="Case_Nature__c" aura:id="CaseNature" required="false"/>
    
                <lightning:inputField fieldName="Type" aura:id="type" required="true" />
                <lightning:inputField fieldName="Sub_Type__c" aura:id="subType" required="true" value="Account Interest Rate Update"/>
               
                <!--CH01 - Start-->
                <aura:if isTrue="{! v.caseModel != null }">
                    <c:LTNG021_AccountInterestRate accountId = "{!v.recordId}" currentAcc = "{!v.currentAcc}" caseModel="{!v.caseModel}" />
                </aura:if>
                <!--CH01 - End-->
                
                <lightning:inputField fieldName="ac_Iban__c" aura:id="ac_Iban" disabled="true" value="{! v.currentAcc.iban}"/>
                <lightning:inputField fieldName="RHA_AccountType__c" aura:id="RHA_AccountType" disabled="true" value="{! v.currentAcc.RHA_AccountType}"/>
                <lightning:inputField fieldName="ac_Currency__c" aura:id="ac_Currency" disabled="true" value="{! v.currentAcc.ac_currency}" />
                
                <lightning:inputField fieldName="AIR_CIFBalance__c" aura:id="AIR_CIFBalance" disabled="true" value="{! v.currentAcc.AIR_CIFBalance}"/>
                <lightning:inputField fieldName="AIR_CurrentInterestRate__c" aura:id="AIR_CurrentInterestRate" disabled="true" value="{! v.currentAcc.AIR_CurrentInterestRate}"/>
                <lightning:inputField fieldName="AIR_SegmentInterestRate__c" aura:id="AIR_SegmentInterestRate" disabled="true" value="{! v.currentAcc.AIR_SegmentInterestRate}"/>
                
                <lightning:inputField fieldName="Customer_Email_Suppression_on_Closure__c" aura:id="CustomerEmailSuppressiononClosure" />
                <lightning:inputField fieldName="Customer_Email_Suppression_on_Creation__c" aura:id="CustomerEmailSuppressiononCreation" />

                <div class="slds-hide">
                    <lightning:inputField fieldName="AccountId" value="{!v.recordId}" aura:id="accId"/>
                </div>
                
                <footer>
                    <div class="slds-float_right">
                        <lightning:button variant="brand" label="Save" type="submit" disabled="{!v.showSpinner}" />
                        <lightning:button variant="brand" label="Cancel" onclick="{!c.onCancel}" />
                    </div>
                </footer>
            </lightning:recordEditForm>
        </aura:if>
        <aura:if isTrue="{!v.showSpinner}">
            <lightning:spinner aura:id="mySpinner" alternativeText="Saving..." title="Saving.." variant="brand" size="large"/>
        </aura:if>
    </lightning:card>
</aura:component>